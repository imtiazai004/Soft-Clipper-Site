{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"trailingSlash": true,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests"
				},
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
				},
				{ "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/shots/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
		},
		{
			"source": "/og.png",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
		}
	]
}
