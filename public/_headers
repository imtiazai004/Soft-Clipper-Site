# Cloudflare Pages reads this file and applies the rules to matching paths.
#
# Everything here is a header the site cannot set for itself: Pages serves
# static files, so there is no server code to add them in.

/*
  # The site loads nothing from anywhere else — no CDN scripts, no webfonts, no
  # analytics — so the policy can say exactly that. 'unsafe-inline' is needed
  # for the two inline scripts (theme) and the scoped <style> blocks Astro emits;
  # there is no external script origin at all, which is the part that matters.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.softclipper.pro; form-action 'self' https://api.softclipper.pro https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
  # Two years, and only turn this on once the domain is definitely staying on
  # HTTPS — it is not something a browser lets you take back quickly.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The site asks for none of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()

# Hashed filenames, so they can never go stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots and the share card are not hashed, so a week with revalidation
# rather than a year: replacing one should not need a rename.
/shots/*
  Cache-Control: public, max-age=604800, must-revalidate

/og.png
  Cache-Control: public, max-age=604800, must-revalidate
