---
import { SITE } from "../consts";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";

interface Props {
	/** Page title without the brand suffix. Keep under ~55 characters. */
	title: string;
	/** Meta description. 140-160 characters is the sweet spot. */
	description: string;
	/** Extra JSON-LD blocks for this page (FAQPage, HowTo, Article, Product...). */
	schema?: Record<string, unknown>[];
	/** Set on pages that must never rank — thank-you pages, for instance. */
	noindex?: boolean;
	/** Overrides the social share image. */
	image?: string;
}

const { title, description, schema = [], noindex = false, image = "/og.png" } = Astro.props;

// Canonical is built from the configured site origin, never from the request —
// otherwise a page served over a preview URL would canonicalise to that URL.
const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const ogImage = new URL(image, SITE.origin).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

/**
 * These two blocks go on every page and describe the same entity every time.
 * Consistent, repeated entity data is what lets search and answer engines treat
 * the site as one identifiable thing rather than a pile of unrelated pages.
 */
const baseSchema = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": `${SITE.origin}/#organization`,
		name: SITE.name,
		legalName: SITE.company,
		url: SITE.origin,
		logo: `${SITE.origin}/soft-clipper-logo.svg`,
		email: SITE.email,
		telephone: SITE.phoneE164,
		// The real registered office, not just a country code. Search engines use
		// this to decide whether a name on a page is a real, identifiable
		// organisation, and a company selling software benefits from being one.
		address: {
			"@type": "PostalAddress",
			streetAddress: SITE.companyAddress.slice(0, 2).join(", "),
			addressLocality: SITE.companyAddress[2],
			postalCode: SITE.companyAddress[3],
			addressCountry: "GB",
		},
		identifier: {
			"@type": "PropertyValue",
			name: "Company number",
			value: SITE.companyNumber,
		},
		contactPoint: [
			{
				"@type": "ContactPoint",
				contactType: "customer support",
				email: SITE.email,
				telephone: SITE.phoneE164,
				availableLanguage: ["English", "Urdu"],
			},
		],
		sameAs: [] as string[],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": `${SITE.origin}/#website`,
		name: SITE.name,
		url: SITE.origin,
		publisher: { "@id": `${SITE.origin}/#organization` },
		inLanguage: "en",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		{/*
		  The theme, decided before anything is painted.

		  This has to be inline, in the head, and ahead of the stylesheet. A
		  deferred or bundled script runs after the first paint, which means a
		  dark-theme visitor gets a white flash on every single page load — the
		  one bug that makes a theme switcher feel broken.

		  is:inline also keeps it out of Astro's bundle, so the site still ships
		  no JavaScript file. This and the toggle in the nav are the only script
		  on the site, and together they are under a kilobyte.

		  No stored choice means follow the operating system, which is the right
		  default: someone who has set their machine to dark has already told us.
		*/}
		<script is:inline>
			(function () {
				var theme = "light";
				try {
					var saved = localStorage.getItem("theme");
					theme =
						saved === "dark" || saved === "light"
							? saved
							: window.matchMedia("(prefers-color-scheme: dark)").matches
								? "dark"
								: "light";
				} catch (e) {
					/* Private mode can throw on localStorage. Light is the fallback. */
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

		{/* Kept in step with the theme by the toggle, so the browser's own chrome
		    on mobile matches the page instead of staying white. */}
		<meta id="theme-color" name="theme-color" content="#ffffff" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={SITE.locale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{
			[...baseSchema, ...schema].map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}
	</head>

	<body>
		<Nav />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<WhatsAppButton />
	</body>
</html>
