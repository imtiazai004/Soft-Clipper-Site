---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import type { Crumb } from "../lib/schema";

interface Props {
	title: string;
	/** The visible H1, when it should read differently from the SEO title. */
	heading?: string;
	description: string;
	/** One or two sentences under the H1 — also the paragraph answer engines quote. */
	intro?: string;
	crumbs: Crumb[];
	schema?: Record<string, unknown>[];
	eyebrow?: string;
	/** Legal and help pages do not need a sales band at the bottom. */
	cta?: boolean;
	narrow?: boolean;
	/** Keep the page out of search results — and out of the sitemap, which is
	 *  handled by the matching entry in astro.config.mjs. */
	noindex?: boolean;
}

const {
	title,
	heading,
	description,
	intro,
	crumbs,
	schema = [],
	eyebrow,
	cta = true,
	narrow = false,
	noindex = false,
} = Astro.props;
---

<Base title={title} description={description} schema={schema} noindex={noindex}>
	<div class={narrow ? "wrap wrap-narrow" : "wrap"}>
		<Breadcrumbs crumbs={crumbs} />
	</div>

	<section class="head">
		<div class={narrow ? "wrap wrap-narrow" : "wrap"}>
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			{/*
			  The same gradient the home page's headline uses. Every page's H1
			  should be the same colour statement — one treatment across the site
			  rather than a gradient on the front page and flat ink everywhere
			  else. It is only the H1: the gradient is a signature, and a signature
			  on every line is a pattern.
			*/}
			<h1 class="gradient-text">{heading ?? title}</h1>
			{intro && <p class="lead">{intro}</p>}
		</div>
	</section>

	<slot />

	{
		cta && (
			<div class="wrap">
				<CtaBand />
			</div>
		)
	}
</Base>

<style>
	.head {
		padding-block: 24px 8px;
	}
	.head h1 {
		margin-bottom: 16px;
	}
</style>
