---
import Page from "../../layouts/Page.astro";
import Faq from "../../components/Faq.astro";
import TerminalInstall from "../../components/TerminalInstall.astro";
import { PRODUCT, SITE } from "../../consts";
import { faqSchema, howToSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Help", href: "/help/" },
	{ label: "Install", href: "/help/install/" },
];

/**
 * Written around the two moments where people stop and give up: the browser
 * offering to delete the file, and the blue SmartScreen panel with no obvious
 * way past it. Both are named here before they happen, with the exact words on
 * the button, because someone who was warned expects them and someone who was
 * not assumes the file is dangerous and deletes it.
 */
const steps = [
	{
		name: "Download the installer",
		text: "The link is in your purchase email next to your licence key, and on the download page. It is about 120 MB.",
	},
	{
		name: 'If your browser says "not commonly downloaded", choose Keep',
		text: 'Chrome and Edge say this about any file few people have downloaded yet, and they offer to delete it. Click the arrow or the three dots next to the warning and choose Keep, then Keep anyway. Nothing was found in the file — it is new, not suspect.',
	},
	{
		name: "Run it, then click More info → Run anyway",
		text: 'Windows shows a blue panel saying it "protected your PC". The Run anyway button is hidden until you click More info first, which is why this stops most people. It is one extra click, not a dead end.',
	},
	{
		name: "Finish the installer",
		text: "It installs for you only, so Windows never asks for an administrator password. Tick the desktop shortcut if you want one.",
	},
	{
		name: "Open it and paste your licence key",
		text: "From the Start menu or the shortcut. Paste the key from your email — activation needs the internet once, and the app runs offline afterwards.",
	},
	{
		name: "Add an AI key, or choose not to need one",
		text: "Settings takes a free Google Gemini key, made in about a minute at Google AI Studio. You can avoid it for YouTube videos that already have captions — pick Ollama or LM Studio and nothing goes to Google. Anything else needs the key to turn speech into text.",
	},
	{
		name: "Try a five-minute video first",
		text: "It confirms the whole chain works in a minute rather than an hour, before you point it at a two-hour recording.",
	},
];

const faqs: FaqItem[] = [
	{
		q: 'Windows says it "protected your PC" and there is only a Don\'t run button.',
		a: 'Click More info on that panel first. A Run anyway button appears underneath. The button is genuinely hidden until you do that, which is why this stops so many people.',
	},
	{
		q: "My browser deleted the file, or offered to.",
		a: 'Chrome and Edge warn about any file that few people have downloaded yet. In the downloads list, click the three dots or the arrow next to Soft Clipper and choose Keep, then Keep anyway. If it is already gone, download it again and choose Keep when asked.',
	},
	{
		q: "Is that warning telling me the file has a virus?",
		a: "No. SmartScreen reports how many people have run a file and whether the publisher paid for a code-signing certificate. Ours has not yet, so every new release starts with no reputation and the warning appears until enough people have installed it. It is a statement about paperwork, not about the file.",
	},
	{
		q: "Will it ask for an administrator password?",
		a: "No. It installs for your user account only, which is also why it works on a locked-down work laptop.",
	},
	{
		q: "Where does it install, and where do the clips go?",
		a: "Into your own AppData folder, not Program Files. Clips go to the folder you pick in Settings, and stay there when you uninstall — an uninstall never touches your clips.",
	},
	{
		q: "How do I uninstall it?",
		a: "Settings → Apps → Soft Clipper → Uninstall, the same as anything else. Your clips are left alone.",
	},
	{
		q: "Do I need ffmpeg or Python installed first?",
		a: "No. Everything is inside the download, ffmpeg included — which is why it is not a small file.",
	},
	{
		q: "How do I get a Gemini API key, and do I have to?",
		a: "Sign in at Google AI Studio with a Google account and create a key; the free tier covers ordinary use, and anything beyond it is billed by Google, never by us. You can avoid it for YouTube videos that already carry captions: choose Ollama or LM Studio in Settings and nothing goes to Google. A local file, or a video without captions, still needs the key — turning speech into text is the one step only Gemini does in this build.",
	},
];
---

<Page
	title="Install Soft Clipper on Windows"
	heading="Installing Soft Clipper"
	description={`Step-by-step install guide for ${SITE.name} on ${PRODUCT.platform}, including the Windows SmartScreen warning and first-run setup.`}
	intro="About five minutes, and four of them are the download. Windows will warn you twice on the way — both are about the app being new, not about anything found in it, and both are one click each. Do not delete the file when your browser offers to."
	eyebrow="Help"
	crumbs={crumbs}
	schema={[
		faqSchema(faqs),
		breadcrumbSchema(crumbs),
		howToSchema({
			name: "Install Soft Clipper on Windows",
			description: "Download, install, activate and configure Soft Clipper.",
			totalTime: "PT5M",
			steps,
		}),
	]}
	cta={false}
>
	<section class="pt-0">
		<div class="wrap">
			<ol class="steps">
				{
					steps.map((s) => (
						<li>
							<h2>{s.name}</h2>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<TerminalInstall os="windows" />
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
			<p class="mt-lg muted">
				Something else broken? <a href="/help/troubleshooting/">Troubleshooting</a> covers the
				common failures, and <a href="/contact/">support</a> covers the rest.
			</p>
		</div>
	</section>
</Page>

<style>
	.pt-0 {
		padding-top: 8px;
	}
	ol.steps h2 {
		font-size: 1.05rem;
		margin-bottom: 4px;
	}
</style>
