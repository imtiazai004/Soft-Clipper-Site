---
// Indexed, or not, by the Mac switch on the admin dashboard — the same switch
// that publishes the download itself. While it is off this page stays out of
// search and out of the sitemap, so a direct link still works for a tester
// while nothing advertises a platform whose download is not there.
//
// One switch rather than two edits, because the failure of two edits is a page
// promising Mac support next to a download that does not exist.
import Page from "../../layouts/Page.astro";
import Faq from "../../components/Faq.astro";
import TerminalInstall from "../../components/TerminalInstall.astro";
import { PRODUCT, SITE } from "../../consts";
import { faqSchema, howToSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Help", href: "/help/" },
	{ label: "Install on Mac", href: "/help/install-mac/" },
];

/**
 * The order here matters more than on Windows.
 *
 * macOS refuses the app first and only offers a way past it afterwards — the
 * "Open Anyway" button does not exist in System Settings until you have tried
 * to open the app and been refused. Anyone who reads the warning and stops
 * there never finds the button, because it is not there yet.
 *
 * Step 3 is therefore written as "you must be refused first", not as an
 * apology for it.
 */
const steps = [
	{
		name: "Open the disk image and drag it to Applications",
		text: "Double-click the downloaded .dmg in Finder. A window opens with Soft Clipper on one side and a shortcut to your Applications folder on the other — drag one onto the other. Then close the window and eject Soft Clipper from the sidebar.",
	},
	{
		name: "Open it from Applications, not from the disk image",
		text: "Running it straight out of the mounted image works once and then behaves strangely, because macOS launches it from a temporary read-only copy. Copy it across first, every time.",
	},
	{
		name: "Double-click it, and expect to be refused",
		text: 'macOS will say it cannot be opened because Apple cannot check it for malicious software — or, on some Macs, that it is "damaged" and should be moved to the Bin. Both mean the same thing and neither is a virus warning. Click Done or Cancel. Do not move it to the Bin.',
	},
	{
		name: "Now open System Settings → Privacy & Security",
		text: 'Scroll down to Security. Because you just tried to open it, there is now a line about Soft Clipper with an Open Anyway button beside it. That button does not appear until you have been refused once, which is why this step comes third.',
	},
	{
		name: "Click Open Anyway, then Open",
		text: "Confirm with Touch ID or your password. macOS asks once more to be sure; choose Open. The app starts, and this Mac never asks again.",
	},
	{
		name: "Paste your licence key",
		text: "The key from your purchase email. One licence covers one computer, and activation needs the internet once — after that it runs offline.",
	},
	{
		name: "Add an AI key, or choose not to need one",
		text: "Settings takes a free Google Gemini key. You can avoid it for YouTube videos that already have captions — pick Ollama or LM Studio and nothing goes to Google. Anything else needs the key to turn speech into text.",
	},
];

const faqs: FaqItem[] = [
	{
		q: 'It says Soft Clipper is "damaged and can\'t be opened. You should move it to the Bin."',
		a: 'Do not move it to the Bin — the file is fine. macOS words it that way for apps that have not been notarised by Apple, which is a paperwork step we have not paid for yet, and the message is the same one it would show for a genuinely broken file. Go to System Settings → Privacy & Security, scroll to Security, and click Open Anyway next to Soft Clipper. That line only appears after you have tried to open the app, so try it first.',
	},
	{
		q: "I looked in Privacy & Security and there is no Open Anyway button.",
		a: "It appears only after macOS has refused the app, and it disappears again after about an hour. Double-click Soft Clipper, dismiss the warning, then go straight to System Settings and the line will be there.",
	},
	{
		q: 'Why does macOS say Apple "cannot check it for malicious software"?',
		a: "Because the app is not signed with an Apple Developer certificate. macOS says this about any app that did not come from the App Store without one. It means Apple has not been told who published it — not that anything was found in it.",
	},
	{
		q: "Is it safe?",
		a: "The warning is about a missing signature, not a detection. If it matters to you, wait until we are signed and notarised — that is on the list, and it removes the warning entirely rather than asking you to click past it.",
	},
	{
		q: "Will I have to do this every time?",
		a: "No. Once per Mac. macOS remembers the decision, and app updates open normally afterwards.",
	},
	{
		q: "Which Macs does it run on?",
		a: "Apple Silicon — M1 and newer — on macOS 12 or later. There is no Intel build, so it will not run on a pre-2020 Mac.",
	},
	{
		q: "Where does it keep my clips and settings?",
		a: "Clips go to the folder you choose in Settings. Your licence and any downloaded speech model live in ~/Library/Application Support/SoftClipper, so moving or reinstalling the app never costs you your activation.",
	},
	{
		q: "How do I uninstall it?",
		a: "Drag Soft Clipper from Applications to the Bin. Your clips stay where they are. To remove the activation as well, delete ~/Library/Application Support/SoftClipper — but release the licence in Settings first if you want to use it on another Mac.",
	},
];
---

<Page
	title="Install Soft Clipper on a Mac"
	heading="Installing on macOS"
	description="How to install and open Soft Clipper on a Mac, including the first-run security warning and what it actually means."
	intro="Two minutes, and macOS will refuse the app once on the way through. That is expected, it is not a virus warning, and the way past it is three clicks. Do not move the app to the Bin when it asks."
	eyebrow="Help"
	crumbs={crumbs}
	noindex={!PRODUCT.macEnabled}
	cta={false}
	narrow
	schema={[
		faqSchema(faqs),
		breadcrumbSchema(crumbs),
		howToSchema({
			name: "Install Soft Clipper on macOS",
			description: "Open the disk image, drag it to Applications, allow it in Privacy & Security, and activate.",
			totalTime: "PT3M",
			steps,
		}),
	]}
>
	<section class="pt-0">
		<div class="wrap wrap-narrow">
			<p class="answer">
				<strong>The short version:</strong> the first time you open it, macOS will refuse and
				say it cannot verify the app. Go to System Settings → Privacy & Security → <em>Open
				Anyway</em>, then open it again. That is the whole obstacle, and it happens once.
			</p>
		</div>
	</section>

	<section class="pt-0">
		<div class="wrap wrap-narrow">
			<ol class="steps">
				{
					steps.map((s) => (
						<li>
							<h2>{s.name}</h2>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<TerminalInstall os="mac" />
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
			<p class="mt-lg muted">
				Stuck at any step? WhatsApp <a href={SITE.waLink} target="_blank" rel="noopener">{SITE.phone}</a>
				or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> — a screenshot of what macOS
				said is usually enough to sort it in one reply.
			</p>
		</div>
	</section>
</Page>

<style>
	.pt-0 {
		padding-top: 8px;
	}
	ol.steps h2 {
		font-size: 1.05rem;
		margin-bottom: 4px;
	}
</style>
