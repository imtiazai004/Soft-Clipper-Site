---
import Page from "../../layouts/Page.astro";
import Faq from "../../components/Faq.astro";
import { PRODUCT, SITE } from "../../consts";
import { faqSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Help", href: "/help/" },
	{ label: "Activate your licence", href: "/help/activate-licence/" },
];

const faqs: FaqItem[] = [
	{
		q: "How do I activate Soft Clipper?",
		a: "Paste the licence key from your purchase email into the box shown at first launch and press Activate. The app contacts the licence server once, ties the key to this computer, and stores a signed token locally so it does not need to ask again.",
	},
	{
		q: "What does activation send?",
		a: "Your licence key and an anonymous hardware fingerprint — a hash built from machine identifiers. No files, no video, no personal data, and no contents of your projects.",
	},
	{
		q: "Do I need to be online to use the app?",
		a: "Only for activation, and for a quiet re-check every couple of weeks. If the check cannot reach the server it keeps working through a grace period, so a weekend without internet is not a problem.",
	},
	{
		q: "I bought a new PC. How do I move my licence?",
		a: "Open Settings on the old machine and choose Release licence, then activate on the new one with the same key. If the old machine is dead or wiped, email support and we will release it for you.",
	},
	{
		q: "It says my key is already active on another computer.",
		a: `That is the one-PC rule doing its job — ${PRODUCT.licence}. Release it from the other machine, or contact support if you no longer have access to it.`,
	},
	{
		q: "Can I use one key on my desktop and my laptop?",
		a: "No. Each machine needs its own licence. Moving a licence between machines is supported; running it on two at once is not.",
	},
	{
		q: "I lost my key.",
		a: "Email support from the address you paid with and we will resend it. We look the key up against that purchase, so there is nothing for you to prove. If you have changed email since buying, write from the new one but include the address you originally paid with.",
	},
];
---

<Page
	title="Activate or move your licence"
	heading="Licence activation"
	description={`How to activate ${SITE.name} with your key, what activation sends, and how to move your licence to a new computer.`}
	intro="One licence covers one computer, activated online once and valid offline afterwards. Moving it to a new machine is a two-minute job you can do yourself."
	eyebrow="Help"
	crumbs={crumbs}
	schema={[faqSchema(faqs), breadcrumbSchema(crumbs)]}
	cta={false}
	narrow
>
	<section class="pt-0">
		<div class="wrap wrap-narrow">
			<p class="answer">
				Paste the key from your purchase email at first launch and press Activate. That is the
				whole process — there is no account to create and no password to remember.
			</p>
		</div>
	</section>

	<section class="pt-0">
		<div class="wrap wrap-narrow">
			<h2>Moving to a new computer</h2>
			<ol class="steps mt-lg">
				<li>
					<h3>Release it on the old machine</h3>
					<p>Settings → Licence → Release. The key becomes free to use elsewhere immediately.</p>
				</li>
				<li>
					<h3>Activate on the new one</h3>
					<p>Install, paste the same key, press Activate.</p>
				</li>
				<li>
					<h3>If the old PC is gone</h3>
					<p>Email support from your purchase address. We release it from our side — this is a normal request, not a favour.</p>
				</li>
			</ol>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
		</div>
	</section>
</Page>

<style>
	.pt-0 {
		padding-top: 8px;
	}
</style>
