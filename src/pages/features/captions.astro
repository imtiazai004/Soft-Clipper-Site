---
import Page from "../../layouts/Page.astro";
import Faq from "../../components/Faq.astro";
import CaptionStyles from "../../components/CaptionStyles.astro";
import { faqSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Features", href: "/features/" },
	{ label: "Captions", href: "/features/captions/" },
];

const faqs: FaqItem[] = [
	{
		q: "Are the captions burned in or a separate file?",
		a: "Burned in — rendered into the pixels of the exported video. Platforms strip or ignore uploaded subtitle files often enough that the safe answer for short-form is to make them part of the picture.",
	},
	{
		q: "Where do the caption words come from?",
		a: "From the same timestamped transcript used to find the moments. If the source video already has captions they are reused, so no extra transcription time is spent.",
	},
	{
		q: "Can the words light up one at a time?",
		a: "Yes. Word-by-word highlighting colours the spoken word while the rest of the phrase stays on screen — the look most short-form uses. It is a switch, and it works with any of the six styles.",
	},
	{
		q: "Can I change how they look?",
		a: "Yes — font size, colour, outline, position and highlight style. Set it on one clip, then apply the same style to every clip in the batch in one action.",
	},
	{
		q: "Do captions work in languages other than English?",
		a: "Yes. Detection and transcription follow the language spoken in the video, including Urdu and Hindi. Fonts for non-Latin scripts must be present on your PC for those characters to render.",
	},
	{
		q: "Can I edit the caption wording?",
		a: "Not the transcribed words themselves — what you control is whether captions are on, which style they use, and how many words appear per line. If a name is transcribed badly, the honest options today are to leave it or to turn captions off for that clip.",
	},
];
---

<Page
	title="Automatic burned-in captions"
	heading="Captions that survive the upload"
	description="Word-timed captions generated from your video's transcript, styled for short-form and burned into the exported clip so no platform can strip them."
	intro="Most short-form video is watched on mute. A clip without captions is a clip most people scroll past, whatever is in it."
	eyebrow="Feature"
	crumbs={crumbs}
	schema={[faqSchema(faqs), breadcrumbSchema(crumbs)]}
>
	<section class="pt-0">
		<div class="wrap">
			<h2>Six styles, on a real frame</h2>
			<p class="lead">
				Every colour here is the one the app burns into your clip. Click through and
				judge them against footage rather than against a swatch.
			</p>
			<div class="mt-lg">
				<CaptionStyles />
			</div>

			<div class="grid grid-2 mt-lg">
				<div class="card">
					<div class="ico">⏱️</div>
					<h3>Timed to the words</h3>
					<p>
						Captions follow the transcript's own timings, so lines change when the speaker
						changes them — not on a fixed timer that drifts out of sync by the end.
					</p>
				</div>
				<div class="card">
					<div class="ico">🎨</div>
					<h3>Styled once, applied to all</h3>
					<p>
						Six styles, including a boxed one that stays readable over bright footage.
						Choose one on a single clip, then push it across the whole batch — ten clips
						from one recording look like a set.
					</p>
				</div>
				<div class="card">
					<div class="ico">📏</div>
					<h3>Two to eight words a line</h3>
					<p>
						A slider controls how much text is on screen at once. Fewer words per line
						reads faster on a phone; more suits dense, technical talk.
					</p>
				</div>
				<div class="card">
					<div class="ico">📱</div>
					<h3>Placed for the safe area</h3>
					<p>
						Positioned to stay clear of the interface each platform draws over the bottom
						of a vertical video, so nothing important sits under a username.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
		</div>
	</section>
</Page>

<style>
	.pt-0 {
		padding-top: 8px;
	}
</style>
