---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PayButton from "../components/PayButton.astro";
import PriceTag from "../components/PriceTag.astro";
import { PRICE, PRODUCT, SITE } from "../consts";
import { faqSchema, softwareSchema, breadcrumbSchema, type FaqItem } from "../lib/schema";

const twoYear = PRICE.competitorMonthly * 24;

const faqs: FaqItem[] = [
	{
		q: `Is ${PRICE.display} really the only payment?`,
		a: `Yes. One payment of ${PRICE.display} buys a licence for one PC, and that licence does not expire. There is no renewal, no upgrade fee for point releases and no usage metering.`,
	},
	{
		q: "What counts as one licence?",
		a: `One licence activates ${SITE.name} on one computer. If you replace or reinstall your PC you can release the licence from the old machine and activate it on the new one from inside the app.`,
	},
	{
		q: "Can I put it on my laptop and my desktop?",
		a: "Not on one licence — each machine needs its own. If you work across two machines regularly, buy two licences; there is no separate multi-seat product to negotiate.",
	},
	{
		q: "Are there ongoing costs I should know about?",
		a: "Only if you want them. By default the AI features use your own Google Gemini API key, which has a free tier that covers ordinary use — anything beyond it you pay Google directly, never us. Or switch transcription and analysis to run on your own PC and there is no account and no bill at all, just a slower first run.",
	},
	{
		q: "What is the refund policy?",
		a: "Fourteen days, no questions asked. Email us from the address you bought with and we refund in full. Because the app runs on your own machine we would rather you tested it properly than kept something you do not use.",
	},
	{
		q: "Will I have to pay again for the next version?",
		a: "No for updates to the version you bought. If a genuinely new major version ships later, existing customers get an upgrade price, never full price again.",
	},
	{
		q: "Do you offer team or agency pricing?",
		a: "Buy one licence per editor. For more than five seats email us and we will sort out a single invoice rather than five card payments.",
	},
];

const schema = [
	softwareSchema(),
	faqSchema(faqs),
	breadcrumbSchema([
		{ label: "Home", href: "/" },
		{ label: "Pricing", href: "/pricing/" },
	]),
];

const included = [
	"AI moment detection across the whole video",
	"Local transcription and local AI — usable with no API key at all",
	"Fixed-length splitting that needs no AI",
	"A virality score, hook title, caption and hashtags per clip",
	"Smart 9:16 reframing that tracks the speaker, plus a gameplay + facecam layout",
	"Export in 9:16, 1:1 or 16:9",
	"Burned-in captions in six styles, with optional word-by-word highlighting",
	"On-screen headlines, text overlays and stickers",
	"Highlight reels and teaser stitching",
	"Batch styling and re-render across every clip",
	"Manual trim, crop and look effects",
	"Unlimited clips, unlimited exports, no watermark",
	"Free updates to the version you bought",
	"Email support",
];

const notIncluded = [
	...(PRODUCT.macEnabled
		? ["A Linux build — Windows and macOS only"]
		: ["macOS or Linux builds — Windows only for now"]),
	"A mobile app — phones cannot render this reliably",
	"The browser version, which is still in development",
	"A Gemini API key — bring your own free one, or run the AI locally instead",
];
---

<Base
	title={`Pricing — ${PRICE.display} one-time, no subscription`}
	description={`Soft Clipper costs ${PRICE.display} once. One licence, one PC, unlimited clips, no monthly fee and no export limits. 14-day refund policy.`}
	schema={schema}
>
	<div class="wrap">
		<Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Pricing", href: "/pricing/" }]} />
	</div>

	<section class="head">
		<div class="wrap center">
			<span class="eyebrow">Pricing</span>
			<h1 class="gradient-text">Pay once. Keep it.</h1>
			<p class="lead">
				No subscription, no credits, no per-minute quota. {SITE.name} runs on your computer,
				so once you own the licence there is nothing left to bill you for.
			</p>
			<p class="answer">
				<strong>How much does {SITE.name} cost?</strong> {PRICE.display} once, not monthly. That
				single payment includes AI moment detection, 9:16 reframing that tracks the speaker,
				burned-in captions, and unlimited clips and exports with no watermark, for one PC. A
				comparable ${PRICE.competitorMonthly}/month cloud subscription adds up to about ${twoYear}
				over two years for the same work. There's a 14-day refund if it isn't for you.
			</p>
		</div>
	</section>

	<section class="pt-0">
		<div class="wrap plan-wrap">
			<div class="plan">
				<div class="plan-head">
					<span class="pill accent">One-time licence</span>
					<div class="price">
						<PriceTag size="block" saving />
						<span class="per muted">once · {PRICE.currency}</span>
					</div>
					<p class="muted small">
						Compared with about ${twoYear} over two years on a ${PRICE.competitorMonthly}/month cloud tool.
					</p>
				</div>

				<PayButton class="buy" label={`Buy ${SITE.name}`} />
				<p class="small muted center">
					Secure checkout · Instant licence key by email · 14-day refund
				</p>

				<ul class="checks">
					{included.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div class="side stack">
				<div class="card">
					<h3>What is not in the box</h3>
					<ul class="crosses">
						{notIncluded.map((item) => <li>{item}</li>)}
					</ul>
				</div>

				<div class="card">
					<h3>Requirements</h3>
					<dl>
						<dt>Operating system</dt>
						<dd>{PRODUCT.platforms}</dd>
						<dt>Memory</dt>
						<dd>{PRODUCT.requirements}</dd>
						<dt>Download size</dt>
						<dd>{PRODUCT.fileSize}</dd>
						<dt>Licence</dt>
						<dd>{PRODUCT.licence}</dd>
					</dl>
				</div>

				<div class="card">
					<h3>Browser version</h3>
					<p>
						A hosted version of {SITE.name} is {PRODUCT.webStatus}. Buying the desktop
						licence today does not include it, and we will not bill you for it by surprise
						either — it will be sold separately when it is ready.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} heading="Questions about buying" />
		</div>
	</section>
</Base>

<style>
	.head {
		padding-bottom: 20px;
	}
	.head h1 {
		margin-block: 10px 16px;
	}
	.pt-0 {
		padding-top: 0;
	}

	.plan-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 24px;
		align-items: start;
	}
	@media (max-width: 900px) {
		.plan-wrap {
			grid-template-columns: 1fr;
		}
	}

	.plan {
		border: 1px solid var(--border-strong);
		border-radius: 22px;
		padding: 34px;
		background:
			radial-gradient(520px 260px at 20% 0%, rgba(109, 63, 224, 0.07), transparent 70%),
			var(--panel);
		box-shadow: var(--shadow-lg);
		display: grid;
		gap: 18px;
	}
	.plan-head {
		display: grid;
		gap: 12px;
		justify-items: start;
	}
	.price {
		display: flex;
		align-items: baseline;
		gap: 10px;
		/* Three things now sit here — old price, new price, "once · USD" — and on
		   a narrow phone they do not fit on one line. */
		flex-wrap: wrap;
	}
	.buy {
		width: 100%;
		padding-block: 17px;
		font-size: 1.05rem;
	}

	.side .card h3 {
		margin-bottom: 12px;
	}

	ul.crosses {
		list-style: none;
		display: grid;
		gap: 9px;
	}
	ul.crosses li {
		position: relative;
		padding-left: 26px;
		color: var(--muted);
		font-size: 0.94rem;
	}
	ul.crosses li::before {
		content: "×";
		position: absolute;
		left: 6px;
		top: -1px;
		color: var(--dim);
		font-size: 1.1rem;
	}

	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 8px 16px;
		font-size: 0.92rem;
	}
	dt {
		color: var(--dim);
	}
	dd {
		color: var(--muted);
	}
</style>
