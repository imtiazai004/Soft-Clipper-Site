---
import Page from "../../layouts/Page.astro";
import Faq from "../../components/Faq.astro";
import { faqSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";
import { PRICE, PRODUCT } from "../../consts";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Compare", href: "/compare/" },
	{ label: "ClipSonic alternative", href: "/compare/clipsonic-alternative/" },
];

const CHECKED = "July 2026";

const faqs: FaqItem[] = [
	{
		q: "Is Soft Clipper a good ClipSonic alternative?",
		a: `They are the closest thing to each other on the market: both are desktop apps, both render locally, both are a one-time payment. Soft Clipper is ${PRICE.display} against ClipSonic's founder price, and it does more after the cut — highlight reels, plain-English search, text overlays, look effects and generated captions with hashtags. ClipSonic has a Mac build and Soft Clipper does not, which for a Mac owner ends the comparison there.`,
	},
	{
		q: "What does ClipSonic cost?",
		a: `As of ${CHECKED}, ClipSonic advertises a founder price of $69 one-time against a stated regular price of $197, with a 7-day money-back guarantee. Soft Clipper is ${PRICE.display} one-time with 14 days.`,
	},
	{
		q: "Do either of them need an API key?",
		a: "Neither has to. Both can transcribe locally with Whisper and both can run the analysis against a local model — Soft Clipper through Ollama or LM Studio, ClipSonic likewise. Soft Clipper defaults to Google Gemini with your own free key, which is faster and more accurate than a small local model on a laptop, but you can switch it off entirely.",
	},
	{
		q: "Does Soft Clipper run on a Mac?",
		a: `No. ${PRODUCT.platform} only. This is the one clear advantage ClipSonic has, and no feature list makes up for software that will not start.`,
	},
	{
		q: "Which one is better for gaming clips?",
		a: "Both do a gameplay-plus-facecam layout. Soft Clipper lets you say which corner your camera sits in and never crops the gameplay panel — it is fitted and padded, because cropping a game to 9:16 throws away where things happen.",
	},
];

const rows = [
	{ f: "Price", a: `${PRICE.display} one-time`, b: "$69 one-time (stated regular $197)" },
	{ f: "Refund window", a: "14 days", b: "7 days" },
	{ f: "Platform", a: "Windows", b: "Windows and Mac" },
	{ f: "Local transcription", a: "Yes — Whisper, model downloaded once", b: "Yes — Whisper" },
	{ f: "Runs the AI locally", a: "Yes — Ollama or LM Studio", b: "Yes — Ollama" },
	{ f: "Cloud AI option", a: "Gemini, Groq, OpenAI", b: "Groq, OpenAI" },
	{ f: "Speaker-tracking reframe", a: "Yes", b: "Yes" },
	{ f: "Gameplay + facecam", a: "Yes, corner of your choice", b: "Yes" },
	{ f: "Word-by-word captions", a: "Yes, six styles", b: "Yes, six styles" },
	{ f: "Fixed-length clips cut on pauses", a: "Yes", b: "Yes" },
	{ f: "Highlight reels and teasers", a: "Yes", b: "Not advertised" },
	{ f: "Plain-English search of the video", a: "Yes", b: "Not advertised" },
	{ f: "Caption and hashtags written for the post", a: "Yes", b: "Not advertised" },
	{ f: "Text overlays, stickers, look effects, speed", a: "Yes", b: "Not advertised" },
	{ f: "Aspect ratios", a: PRODUCT.ratios, b: "9:16" },
	{ f: "Per-clip AI re-edit", a: "Yes", b: "Not advertised" },
];
---

<Page
	title="Soft Clipper vs ClipSonic"
	heading="Soft Clipper as a ClipSonic alternative"
	description={`An honest comparison of two local, one-time-payment clip tools. Where ClipSonic wins, where Soft Clipper wins, and the Mac question. Pricing checked ${CHECKED}.`}
	intro="These two are more alike than either is like a cloud tool: desktop apps, local rendering, pay once. So the comparison is about what happens after the cut — and about which computer you own."
	eyebrow="Comparison"
	crumbs={crumbs}
	schema={[faqSchema(faqs), breadcrumbSchema(crumbs)]}
>
	<section class="pt-0">
		<div class="wrap">
			<p class="answer">
				<strong>Short answer:</strong> on a Mac, buy ClipSonic — Soft Clipper does not run
				there. On Windows, Soft Clipper is cheaper, gives you longer to change your mind, and
				does considerably more once the clips exist: highlight reels, plain-English search,
				overlays and effects, and a written caption with hashtags for each clip.
			</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>Side by side</h2>
			<p class="lead">
				Checked {CHECKED} against ClipSonic's own published material. "Not advertised" means
				exactly that — it may exist without being on their site.
			</p>
			<div class="table-scroll mt-lg">
				<table>
					<thead>
						<tr><th>&nbsp;</th><th>Soft Clipper</th><th>ClipSonic</th></tr>
					</thead>
					<tbody>
						{
							rows.map((r) => (
								<tr>
									<td><strong>{r.f}</strong></td>
									<td>{r.a}</td>
									<td>{r.b}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<div class="grid grid-2">
				<div class="card">
					<h2>Where ClipSonic wins</h2>
					<ul class="checks">
						<li><strong>It runs on a Mac.</strong> If that is your computer, nothing else on this page matters.</li>
						<li><strong>It has been selling longer</strong> and has public testimonials behind it.</li>
					</ul>
				</div>
				<div class="card">
					<h2>Where Soft Clipper wins</h2>
					<ul class="checks">
						<li><strong>{PRICE.display} instead of $69</strong>, and 14 days to change your mind instead of 7.</li>
						<li><strong>Highlight reels.</strong> Several moments stitched into one trailer, not just separate clips.</li>
						<li><strong>Ask for what you want</strong> — "the part about pricing" — instead of taking a generic best-of list.</li>
						<li><strong>The post is written for you</strong>: hook title, caption and hashtags per clip.</li>
						<li><strong>Overlays, stickers, look effects and speed</strong>, applied to one clip or the whole batch.</li>
						<li><strong>{PRODUCT.ratios}</strong>, not vertical only.</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<div class="section-head">
				<h2>On the "$197" price</h2>
			</div>
			<p class="lead">
				ClipSonic shows $69 against a stated regular price of $197. We do not do that. A
				crossed-out price you have never actually charged is a discount that is not a
				discount, and UK advertising rules — we are a UK company — take a dim view of it.
				{PRICE.display} is simply what Soft Clipper costs.
			</p>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
		</div>
	</section>
</Page>

<style>
	.pt-0 {
		padding-top: 8px;
	}
	.card h2 {
		font-size: 1.2rem;
		margin-bottom: 14px;
	}
</style>
