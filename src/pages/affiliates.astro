---
/**
 * The affiliate programme — recruitment page and the terms in one.
 *
 * Deliberately not two pages. Someone deciding whether to promote this wants to
 * know the rate, when they get paid and what disqualifies them, and splitting
 * those across a friendly page and a legal one means the rules are read by
 * nobody until there is an argument about them.
 */
import Page from "../layouts/Page.astro";
import Faq from "../components/Faq.astro";
import { AFFILIATES, API_ORIGIN, PRICE, PRODUCT, SITE } from "../consts";
import { faqSchema, breadcrumbSchema, type FaqItem } from "../lib/schema";

/**
 * Every country, by name, in the visitor's alphabetical order.
 *
 * Built from the ISO codes rather than a hand-typed list of names, so it cannot
 * quietly go out of date and cannot be missing somebody's — which matters more
 * here than anywhere else on the site. Half of these are places Stripe will not
 * pay out to, and an affiliate in one of them is paid by hand instead; a form
 * that only offered the countries Stripe reaches would be a form that turned
 * away exactly the people most likely to promote this.
 */
const ISO_CODES =
	"AD AE AF AG AI AL AM AO AR AT AU AW AZ BA BB BD BE BF BG BH BI BJ BM BN BO BR BS BT BW BY BZ " +
	"CA CD CF CG CH CI CL CM CN CO CR CU CV CW CY CZ DE DJ DK DM DO DZ EC EE EG ER ES ET FI FJ FM " +
	"FO FR GA GB GD GE GH GI GL GM GN GQ GR GT GW GY HK HN HR HT HU ID IE IL IM IN IQ IR IS IT JE " +
	"JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MG MH " +
	"MK ML MM MN MO MR MT MU MV MW MX MY MZ NA NE NG NI NL NO NP NR NZ OM PA PE PG PH PK PL PR PS " +
	"PT PW PY QA RO RS RU RW SA SB SC SD SE SG SI SK SL SM SN SO SR SS ST SV SY SZ TC TD TG TH TJ " +
	"TL TM TN TO TR TT TV TW TZ UA UG US UY UZ VA VC VE VG VN VU WS XK YE ZA ZM ZW";
const names = new Intl.DisplayNames(["en"], { type: "region" });
const COUNTRIES = ISO_CODES.split(" ")
	.map((code) => ({ code, name: (() => { try { return names.of(code) || code; } catch { return code; } })() }))
	.sort((a, b) => a.name.localeCompare(b.name, "en"));

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Affiliates", href: "/affiliates/" },
];
const UPDATED = "30 July 2026";

/**
 * The same numbers the licence server pays out on, read from it at build time.
 * Advertising 30% here while the server credits 20% is the kind of mismatch
 * that is only discovered by the person it shortchanged.
 */
const RATE = AFFILIATES.ratePct;
const HOLD_DAYS = AFFILIATES.holdDays;
const COOKIE_DAYS = AFFILIATES.windowDays;
const perSale = ((PRICE.amount * RATE) / 100).toFixed(2);

const faqs: FaqItem[] = [
	{
		q: "How much do I earn per sale?",
		a: `${RATE}% of what the customer actually pays. At today's price of ${PRICE.display} that is $${perSale} a sale, and there is no cap on how many.`,
	},
	{
		q: "How long does the referral last?",
		a: `${COOKIE_DAYS} days from the click. If someone follows your link and buys five weeks later, it is still your sale. If they follow a different affiliate's link in between, it becomes theirs — the most recent link wins.`,
	},
	{
		q: "When do I get paid?",
		a: `Commission is released ${HOLD_DAYS} days after the sale, once the 14-day refund window has closed and then some. After that it is paid out on request or monthly, whichever comes first.`,
	},
	{
		q: "How do I get paid?",
		a: "Automatically through Stripe if you are in a country Stripe pays out to — you connect an account once and the money arrives on its own. If you are not, we send it by Wise or PayPal by hand. Either way it is the same commission on the same schedule.",
	},
	{
		q: "What happens if my referral asks for a refund?",
		a: "The commission is cancelled, because the sale was. This is the reason for the holding period rather than paying on the day — it means the money you are told you have earned is money you get to keep.",
	},
	{
		q: "Can I buy through my own link?",
		a: "No. Self-referrals earn nothing and are the one thing that gets an account closed. If you want the software for yourself, ask and we will sort you out.",
	},
	{
		q: "Can I run ads on the brand name?",
		a: "Not on 'Soft Clipper' or close variants. Bidding on our own name puts you between us and people already looking for us, which costs us money to win back a customer we already had.",
	},
	{
		q: "How do I join?",
		a: AFFILIATES.selfSignup
			? "Fill in the form on this page. You confirm your email address, and your link works from that moment — there is nothing to install, no minimum audience and nobody to wait for."
			: `Email ${SITE.email} with where you would be promoting. We reply with your link, and there is nothing to install.`,
	},
	{
		q: "Do I have to be in a particular country?",
		a: "No. Anywhere at all. Where you live decides how the money reaches you, not whether it does — Stripe pays out automatically in around fifty countries, and everywhere else we send it by Wise or PayPal ourselves, on the same schedule for the same commission.",
	},
	{
		q: "Where do I see how I am doing?",
		a: "You get your own dashboard — clicks, sales, what is still being held and what is ready to be paid, plus where you want the money sent. You sign in with your email address; there is no password to lose.",
	},
];

const rules = [
	{
		t: "Say what it is",
		d: `${PRODUCT.appNoun.charAt(0).toUpperCase() + PRODUCT.appNoun.slice(1)} that cuts long videos into vertical clips. Do not promise${PRODUCT.macEnabled ? "" : " a Mac version,"} a mobile app, cloud rendering or auto-posting — none of those exist, and the refund lands on us.`,
	},
	{
		t: "Say the price honestly",
		d: `${PRICE.display} one time. Do not invent discounts, countdowns or a "was ${PRICE.listDisplay} today only" that is not real.`,
	},
	{
		t: "No brand bidding",
		d: "No paid search on our name or close misspellings, and no domain that could be mistaken for ours.",
	},
	{
		t: "No spam, no fake accounts",
		d: "No unsolicited email, no comment spam, no cookie stuffing, no bought traffic. One complaint of this kind ends the arrangement.",
	},
	{
		t: "No self-referral",
		d: "Your own purchase, your family's, or an account you control earns nothing.",
	},
	{
		t: "Do not speak for us",
		d: "You are an independent promoter, not an employee or agent. Do not answer support questions on our behalf — send them to us.",
	},
];
---

<Page
	title={`Affiliate programme — earn ${RATE}% per sale`}
	heading={`Earn $${perSale} for every copy you sell`}
	description={`Promote Soft Clipper and earn ${RATE}% of every sale — $${perSale} on a ${PRICE.display} licence. ${COOKIE_DAYS}-day attribution, paid by Stripe or by hand depending on your country.`}
	intro={`${RATE}% commission, no cap, and a ${COOKIE_DAYS}-day window from the click. Paid automatically through Stripe where Stripe reaches, and by Wise or PayPal where it does not.`}
	eyebrow="Affiliates"
	crumbs={crumbs}
	schema={[faqSchema(faqs), breadcrumbSchema(crumbs)]}
>
	<section>
		<div class="wrap">
			<div class="numbers">
				<div class="card stat">
					<span class="big gradient-text">{RATE}%</span>
					<p>of every sale, uncapped</p>
				</div>
				<div class="card stat">
					<span class="big gradient-text">${perSale}</span>
					<p>per licence at today's price</p>
				</div>
				<div class="card stat">
					<span class="big gradient-text">{COOKIE_DAYS} days</span>
					<p>from the click to the sale</p>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<h2>How it works</h2>
			<ol class="steps">
				<li>
					<strong>{AFFILIATES.selfSignup ? "You pick your link" : "You get a link"}</strong> —
					something like <code>{SITE.origin}/?ref=yourname</code>. Put it anywhere: a video
					description, a newsletter, a blog post, a pinned comment.
				</li>
				<li>
					<strong>Someone follows it and buys</strong>, on that visit or up to
					{COOKIE_DAYS} days later. They pay the normal price — a referral link
					costs the buyer nothing extra.
				</li>
				<li>
					<strong>The sale is recorded against you</strong> the moment the payment
					clears. Your <a href={AFFILIATES.portalUrl}>dashboard</a> shows it, alongside
					how many people have followed your link.
				</li>
				<li>
					<strong>It is paid {HOLD_DAYS} days later</strong>, once it can no longer
					be refunded.
				</li>
			</ol>

			<h2>Getting paid</h2>
			<p>
				Where you live decides how, not how much.
			</p>
			<div class="cols">
				<div class="card">
					<h3>Stripe pays out to your country</h3>
					<p>
						You connect an account once — Stripe collects your details and does its
						own identity checks. After that commission arrives automatically and we
						never touch your bank details.
					</p>
				</div>
				<div class="card">
					<h3>Stripe does not</h3>
					<p>
						Pakistan, Bangladesh, Nigeria and a good many others. We send it by Wise
						or PayPal by hand instead, on the same schedule. Nothing about your
						commission changes; only the plumbing does.
					</p>
				</div>
			</div>

			<h2>The rules</h2>
			<p>
				Short, and all of them are here because breaking them costs us a customer
				rather than because a lawyer liked the sound of them.
			</p>
			<div class="rules">
				{
					rules.map((r) => (
						<div class="rule">
							<h3>{r.t}</h3>
							<p>{r.d}</p>
						</div>
					))
				}
			</div>

			<h2>The boring part</h2>
			<p class="small muted">
				This programme is run by {SITE.company}, company number {SITE.companyNumber},
				registered in {SITE.companyRegisteredIn} at {SITE.companyAddressLine}. Commission
				is paid on completed, non-refunded sales only. You are responsible for any tax
				on what you earn, and for following the advertising rules and disclosure
				requirements where you live — most places require you to say that a link is an
				affiliate link. We can change the rate or end the programme with 30 days'
				notice, and commission already earned is still paid. We can close an account
				immediately for the things listed above, in which case unpaid commission on
				affected sales is not paid. Last updated {UPDATED}.
			</p>

			<div class="join card" id="join">
				<h2 style="margin-top:0">{AFFILIATES.open ? "Join" : "Sign-ups are closed"}</h2>
				{
					AFFILIATES.selfSignup ? (
						<Fragment>
							<p>
								Sign yourself up — from anywhere in the world, in about a minute. You confirm
								your email address and your link works from that moment. There is nothing to
								install, no minimum audience and nobody to wait for.
							</p>

							{/*
							  A plain form that submits itself. No `fetch`, no CORS, no
							  JavaScript required for any of it to work.

							  It used to post with `fetch`, and that failed for a real
							  person on a real connection: an XHR to another host is the
							  thing ad blockers, privacy extensions, company firewalls and
							  antivirus proxies all filter, while leaving ordinary
							  navigation alone. When one of them drops it the browser hands
							  JavaScript "Failed to fetch" — no status, no reason — and the
							  server, healthy and answering everybody else, has no record
							  that anything was ever asked of it. There is no way to debug
							  that from either end.

							  A form post is a navigation. Nothing filters it, it survives
							  JavaScript being off or broken, and the answer comes back as
							  a page rather than a promise. The server replies with a
							  redirect to the affiliate dashboard, which says what happened.
							*/}
							<form
								id="joinForm"
								method="post"
								action={`${API_ORIGIN}/partner/join`}
							>
								<div class="pair">
									<label class="fld">
										<span>Your name</span>
										<input name="name" required autocomplete="name" placeholder="Imtiaz Ahmad" />
									</label>
									<label class="fld">
										<span>Email</span>
										<input
											name="email"
											type="email"
											required
											autocomplete="email"
											placeholder="you@example.com"
										/>
										<em>Where your link, your sign-in and your money are arranged.</em>
									</label>
								</div>

								<div class="pair">
									<label class="fld">
										<span>Choose your link</span>
										<input
											name="code"
											required
											minlength="3"
											maxlength="40"
											autocapitalize="off"
											autocorrect="off"
											spellcheck="false"
											placeholder="imtiazahmad"
										/>
										<em id="linkPreview">Letters and numbers. This is what people will see.</em>
									</label>
									<label class="fld">
										<span>Country</span>
										<select name="country">
											<option value="">Choose…</option>
											{COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
										</select>
										<em>Only decides how we send the money, never how much.</em>
									</label>
								</div>

								<label class="fld">
									<span>Where will you be promoting? (optional)</span>
									<input
										name="promo"
										maxlength="500"
										placeholder="YouTube channel about video editing, 12k subs"
									/>
								</label>

								{/*
								  A field no person ever sees and no person ever fills in. Bots fill
								  in everything on a form, so anything arriving with this set is
								  answered with a polite success and quietly dropped. Hidden with
								  position rather than `display:none` or `hidden`, both of which the
								  better scripts know to skip.
								*/}
								<div class="hp" aria-hidden="true">
									<label>
										Website
										<input name="website" tabindex="-1" autocomplete="off" />
									</label>
								</div>

								<div class="row">
									<button class="btn btn-primary" type="submit" id="joinBtn">
										Create my link
									</button>
									<span class="small muted">
										{AFFILIATES.ratePct}% per sale · no cap · nothing to install
									</span>
								</div>
							</form>

							<p class="small muted" style="margin-bottom:0">
								Already signed up? <a href={AFFILIATES.portalUrl}>Open your dashboard</a> — it
								emails you a way in. Already have a link? Just use it; it starts working the
								first time someone clicks it.
							</p>
						</Fragment>
					) : AFFILIATES.open ? (
						<Fragment>
							<p>
								Email <a href={`mailto:${SITE.email}?subject=Affiliate%20programme`}>{SITE.email}</a>
								and say where you would be promoting. We will send your link back, usually the
								same day. There is nothing to install and no minimum audience.
							</p>
							<p class="small muted" style="margin-bottom:0">
								Already have a link? Just use it — it starts working the first time someone
								clicks it.
							</p>
						</Fragment>
					) : (
						/*
						 * Closed to new sign-ups, but the page stays up and stays honest.
						 * People already promoting need the rules to keep existing, and
						 * the one thing they will want to know first is whether they are
						 * still getting paid.
						 */
						<Fragment>
							<p>
								We are not taking new affiliates at the moment. The page stays here because
								the terms still apply to everyone already promoting.
							</p>
							<p class="small muted" style="margin-bottom:0">
								<strong>If you already have a link:</strong> commission you have earned is
								still owed and still being paid on the usual schedule. Email{" "}
								<a href={`mailto:${SITE.email}?subject=Affiliate%20programme`}>{SITE.email}</a>
								{" "}with anything at all.
							</p>
						</Fragment>
					)
				}
			</div>

			<Faq items={faqs} heading="Questions" />
		</div>
	</section>
</Page>

{
	/*
	 * Everything left that JavaScript does on this page: show what the chosen
	 * code turns into, live.
	 *
	 * The submitting used to live here too, as a `fetch`. It is gone — the form
	 * posts itself now. See the comment on the <form> for why, but the short
	 * version is that a cross-host XHR is the one kind of request that ad
	 * blockers, privacy extensions and company firewalls filter, and when one of
	 * them drops it the browser reports a bare "Failed to fetch" while the server
	 * has no record the request ever existed.
	 *
	 * What remains cannot fail in any way that matters: with the script blocked,
	 * or JavaScript off entirely, the field simply keeps its written hint and the
	 * form still works.
	 */
	AFFILIATES.selfSignup && (
		<script is:inline define:vars={{ origin: SITE.origin }}>
			(function () {
				var form = document.getElementById("joinForm");
				if (!form) return;
				var codeInput = form.elements.code;
				var preview = document.getElementById("linkPreview");
				if (!codeInput || !preview) return;

				// The same normalisation the server applies, shown as they type.
				// Somebody entering "Imtiaz Ahmad" should see what that becomes before
				// they commit to it, rather than finding out from their own link a week
				// later. The server does it again on arrival — this is a courtesy, not
				// a check, and nothing depends on it having run.
				function tidy(value) {
					return String(value || "").trim().toLowerCase().replace(/[^a-z0-9_-]/g, "").slice(0, 40);
				}

				codeInput.addEventListener("input", function () {
					var code = tidy(codeInput.value);
					preview.textContent = code.length >= 3
						? "Your link: " + origin + "/?ref=" + code
						: "Letters and numbers. This is what people will see.";
				});
			})();
		</script>
	)
}

<style>
	.numbers {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 16px;
	}
	.stat {
		text-align: center;
	}
	.stat .big {
		display: block;
		font-size: clamp(2.2rem, 6vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
	.stat p {
		margin: 6px 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}

	h2 {
		margin-top: 44px;
		margin-bottom: 14px;
	}

	/*
	 * No padding rules here.
	 *
	 * This page used to set `.steps li { padding-left: 4px }`, and because a
	 * scoped Astro style outranks the global one it beat `ol.steps li`'s
	 * `padding-left: 62px` — the gap the numbered badge is absolutely positioned
	 * into. The badges landed on top of the first word of every step: "Y1et a
	 * link", "S2eone follows it and buys". It rendered, it deployed, and it read
	 * as broken to everyone who saw it.
	 *
	 * The global `ol.steps` styling is already the card-with-a-number look this
	 * page wants, so the right amount of CSS here is none.
	 */
	.steps code {
		white-space: nowrap;
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}
	.cols h3 {
		margin-bottom: 8px;
	}

	.rules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 18px 28px;
	}
	.rule h3 {
		font-size: 1rem;
		margin-bottom: 5px;
	}
	.rule p {
		color: var(--muted);
		font-size: 0.94rem;
		margin: 0;
	}

	.join {
		margin-top: 40px;
	}

	/* The sign-up form. Built from the site's own variables rather than fixed
	   colours so it follows the theme like everything else on the page. */
	#joinForm {
		margin: 20px 0 18px;
		display: grid;
		gap: 14px;
	}
	.pair {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 14px;
	}
	.fld {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.fld > span {
		font-size: 0.85rem;
		font-weight: 600;
	}
	.fld input,
	.fld select {
		font: inherit;
		color: var(--text);
		background: var(--panel);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 10px 12px;
		width: 100%;
	}
	.fld input:focus,
	.fld select:focus {
		outline: 2px solid var(--violet);
		outline-offset: 1px;
	}
	.fld em {
		font-style: normal;
		font-size: 0.82rem;
		color: var(--dim);
		/* Reserves its own line so the live link preview appearing under the code
		   box does not shove the rest of the form down as somebody types. */
		min-height: 1.2em;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	/* Off-screen rather than display:none — a script that fills in forms skips
	   what is hidden the obvious way, and this only works if it gets filled in. */
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

</style>
