---
import Base from "../layouts/Base.astro";
import { API_ORIGIN, PRICE, SITE } from "../consts";

const stripeReady = PRICE.checkoutUrl.length > 0;
const stripeTest = PRICE.checkoutUrl.includes("/test_");
---

<Base
	title="Checkout"
	description={`Choose card or bank transfer/wallet to buy a ${SITE.name} lifetime licence.`}
	noindex={true}
>
	<section class="checkout-section">
		<div class="wrap">
			<div class="checkout-head">
				<p class="eyebrow">Secure checkout</p>
				<h1>Buy your lifetime licence</h1>
				<p class="lead">Pay once, clip forever. Choose the payment method that works where you are.</p>
			</div>

			<div class="checkout-grid">
				<aside class="summary card-panel" aria-label="Order summary">
					<h2>Order summary</h2>
					<div class="product-row">
						<div>
							<strong>{SITE.name} Pro Lifetime</strong>
							<span>One licence · one computer · no subscription</span>
						</div>
						<strong class="price">{PRICE.display}</strong>
					</div>
					<div class="summary-line"><span>Subtotal</span><strong>{PRICE.display} USD</strong></div>
					<div class="summary-line total"><span>Total</span><strong id="orderTotal">{PRICE.display} USD</strong></div>
					<p id="pkrSummary" class="pkr-summary" hidden></p>
					<ul class="trust-list">
						<li>Licence emailed after payment confirmation</li>
						<li>Windows and Mac download included</li>
						<li>14-day refund policy</li>
					</ul>
				</aside>

				<div class="payment card-panel">
					<h2>Payment method</h2>
					<div class="method-tabs" role="tablist" aria-label="Payment method">
						<button id="cardTab" class="method-tab active" type="button" role="tab" aria-selected="true" aria-controls="cardPanel">
							<span aria-hidden="true">▣</span> Card / international
						</button>
						<button id="bankTab" class="method-tab" type="button" role="tab" aria-selected="false" aria-controls="bankPanel">
							<span aria-hidden="true">▥</span> Bank Transfer/Wallet
						</button>
					</div>

					<div id="cardPanel" class="method-panel" role="tabpanel" aria-labelledby="cardTab">
						<div class="method-intro">
							<div class="method-icon" aria-hidden="true">$</div>
							<div>
								<h3>Pay securely with Stripe</h3>
								<p>Use an international debit or credit card. Your licence is issued automatically.</p>
							</div>
						</div>
						{
							stripeReady ? (
								<a id="cardCheckout" class="btn btn-primary full" href={PRICE.checkoutUrl} rel="nofollow">
									Continue to secure card payment
								</a>
							) : (
								<a class="btn btn-primary full" href={`${SITE.waLink}?text=${encodeURIComponent(`Hi, I would like to buy ${SITE.name}.`)}`} target="_blank" rel="nofollow noopener">
									Message us to pay
								</a>
							)
						}
		{stripeTest && <p class="alert warn"><strong>Card test mode:</strong> this Stripe link does not take real card payments.</p>}
					</div>

					<div id="bankPanel" class="method-panel" role="tabpanel" aria-labelledby="bankTab" hidden>
						<div id="bankStart">
							<div class="local-note">
								<strong>Pay by bank transfer or wallet</strong>
								<span>Your USD price is converted automatically using the latest State Bank of Pakistan offer rate.</span>
							</div>

							<label class="field">
								<span>Licence email</span>
								<input id="bankEmail" type="email" autocomplete="email" placeholder="you@example.com" required />
							</label>

							<fieldset class="local-methods">
								<legend>Where will you send the payment?</legend>
								<label class="local-choice selected">
									<input type="radio" name="localMethod" value="bank" checked />
									<span><strong>Bank Al-Habib / Raast</strong><small>IBAN, Raast or QR</small></span>
								</label>
								<label class="local-choice">
									<input type="radio" name="localMethod" value="jazzcash" />
									<span><strong>JazzCash</strong><small>Send from a JazzCash mobile wallet</small></span>
								</label>
							</fieldset>

							<button id="makeOrder" class="btn btn-primary full" type="button">Get PKR amount &amp; payment details</button>
							<p id="bankStartError" class="alert error" hidden></p>
						</div>

						<div id="bankPay" hidden>
							<div class="quote-box">
								<span>Send exactly</span>
								<strong id="pkrAmount">PKR —</strong>
								<small id="rateLine"></small>
							</div>

							<div class="order-ref">
								<span>Order reference</span>
								<strong id="orderReference"></strong>
							</div>

							<div id="bankDetails" class="details-box">
								<div class="detail-copy">
									<h3 id="receiverHeading">Bank Al-Habib</h3>
									<dl>
										<div><dt>Account title</dt><dd id="receiverTitle"></dd></div>
										<div><dt id="receiverNumberLabel">IBAN</dt><dd><span id="receiverNumber"></span><button class="copy" type="button" data-copy="receiverNumber">Copy</button></dd></div>
									</dl>
								</div>
								<button id="qrZoom" class="bank-qr" type="button" aria-haspopup="dialog">
									<img id="bankQr" alt="Bank Al-Habib payment QR code" />
									<span>Tap to enlarge</span>
								</button>
							</div>

							<p class="instruction">After sending the exact amount, enter the transaction ID shown by your bank or JazzCash. We verify the actual incoming credit before issuing a licence.</p>

							<label class="field">
								<span>Transaction ID</span>
								<input id="transactionId" autocomplete="off" placeholder="Enter the bank or JazzCash transaction ID" required />
							</label>
							<label class="field">
								<span>Payment screenshot <em>optional</em></span>
								<input id="paymentProof" type="file" accept="image/jpeg,image/png,image/webp" />
								<small>JPG, PNG or WebP · maximum 4 MB. A screenshot alone is not treated as payment confirmation.</small>
							</label>

							<button id="submitPayment" class="btn btn-primary full" type="button">Submit payment for verification</button>
							<p id="bankPayError" class="alert error" hidden></p>
						</div>

						<div id="bankDone" class="done" hidden>
							<div class="done-mark" aria-hidden="true">✓</div>
							<h3>Payment submitted</h3>
							<p>We will verify the receiving account. Your licence is emailed as soon as the transfer is approved.</p>
							<p class="done-ref">Keep this reference: <strong id="doneReference"></strong></p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div id="qrModal" class="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qrModalTitle" hidden>
			<div class="qr-modal-card">
				<h2 id="qrModalTitle">Scan to pay</h2>
				<img id="qrModalImage" alt="Bank Al-Habib payment QR code, enlarged" />
				<p id="qrModalAmount"></p>
				<button id="qrModalClose" class="btn btn-primary full" type="button">Close</button>
			</div>
		</div>
	</section>
</Base>

<script is:inline define:vars={{ apiOrigin: API_ORIGIN }}>
	(function () {
		var cardTab = document.getElementById("cardTab");
		var bankTab = document.getElementById("bankTab");
		var cardPanel = document.getElementById("cardPanel");
		var bankPanel = document.getElementById("bankPanel");
		var currentOrder = null;
		var orderToken = "";

		function showMethod(which) {
			var bank = which === "bank";
			cardTab.classList.toggle("active", !bank);
			bankTab.classList.toggle("active", bank);
			cardTab.setAttribute("aria-selected", String(!bank));
			bankTab.setAttribute("aria-selected", String(bank));
			cardPanel.hidden = bank;
			bankPanel.hidden = !bank;
		}

		cardTab.addEventListener("click", function () { showMethod("card"); });
		bankTab.addEventListener("click", function () { showMethod("bank"); });

		document.querySelectorAll('input[name="localMethod"]').forEach(function (radio) {
			radio.addEventListener("change", function () {
				document.querySelectorAll(".local-choice").forEach(function (choice) {
					choice.classList.toggle("selected", choice.contains(radio));
				});
			});
		});

		function affiliateCode() {
			try {
				var saved = JSON.parse(localStorage.getItem("sc-ref") || "{}");
				return saved.code && Date.now() <= saved.until ? saved.code : "";
			} catch (e) {
				return "";
			}
		}

		async function request(path, options) {
			var response = await fetch(apiOrigin + path, options);
			var body = await response.json().catch(function () { return {}; });
			if (!response.ok) throw new Error(body.error || body.detail || "The payment service could not complete that request.");
			return body;
		}

		function busy(button, on, label) {
			if (!button.dataset.label) button.dataset.label = button.textContent;
			button.disabled = on;
			button.textContent = on ? label : button.dataset.label;
		}

		function showError(id, message) {
			var box = document.getElementById(id);
			box.textContent = message || "";
			box.hidden = !message;
		}

		function moneyPKR(amount) {
			return "PKR " + Number(amount).toLocaleString("en-PK");
		}

		function fillPaymentDetails(data) {
			var order = data.order;
			var details = data.payment_details;
			var useJazz = order.method === "jazzcash";
			var receiver = useJazz ? details.jazzcash : details.bank;

			document.getElementById("pkrAmount").textContent = moneyPKR(order.pkr_amount);
			document.getElementById("orderTotal").textContent = moneyPKR(order.pkr_amount);
			var summary = document.getElementById("pkrSummary");
			summary.textContent = "$" + (order.usd_cents / 100).toFixed(0) + " converted at 1 USD = " + order.fx_rate + " PKR";
			summary.hidden = false;
			document.getElementById("rateLine").textContent =
				"1 USD = " + order.fx_rate + " PKR · State Bank of Pakistan, " + order.rate_date +
				(order.rate_stale ? " · most recent stored rate" : "");
			document.getElementById("orderReference").textContent = order.reference;
			document.getElementById("receiverHeading").textContent = useJazz ? "JazzCash" : receiver.name;
			document.getElementById("receiverTitle").textContent = receiver.title;
			document.getElementById("receiverNumberLabel").textContent = useJazz ? "Mobile number" : "IBAN";
			document.getElementById("receiverNumber").textContent = useJazz ? receiver.number : (receiver.iban || receiver.account);
			var qr = document.getElementById("bankQr");
			document.getElementById("qrZoom").hidden = useJazz;
			if (!useJazz) qr.src = receiver.qr_url;
			document.getElementById("bankStart").hidden = true;
			document.getElementById("bankPay").hidden = false;
		}

		document.getElementById("makeOrder").addEventListener("click", async function () {
			var button = this;
			var email = document.getElementById("bankEmail").value.trim();
			var method = document.querySelector('input[name="localMethod"]:checked').value;
			showError("bankStartError", "");
			if (!email || !document.getElementById("bankEmail").checkValidity()) {
				document.getElementById("bankEmail").reportValidity();
				return;
			}
			busy(button, true, "Getting current PKR rate…");
			try {
				var data = await request("/api/checkout/bank/orders", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email: email, method: method, ref: affiliateCode() }),
				});
				currentOrder = data.order;
				orderToken = data.token;
				fillPaymentDetails(data);
			} catch (e) {
				showError("bankStartError", e.message);
			} finally {
				busy(button, false, "");
			}
		});

		document.querySelectorAll("[data-copy]").forEach(function (button) {
			button.addEventListener("click", async function () {
				var value = document.getElementById(button.dataset.copy).textContent;
				try {
					await navigator.clipboard.writeText(value);
					var old = button.textContent;
					button.textContent = "Copied";
					setTimeout(function () { button.textContent = old; }, 1400);
				} catch (e) {
					window.prompt("Copy this value", value);
				}
			});
		});

		// The printed QR is 150px wide — enough to see that it is a QR, not enough
		// for a phone held at arm's length over a laptop screen. Clicking it shows
		// the same image at the size a camera actually wants.
		var qrModal = document.getElementById("qrModal");
		var qrZoom = document.getElementById("qrZoom");

		function openQr() {
			var source = document.getElementById("bankQr");
			if (!source.getAttribute("src")) return;
			document.getElementById("qrModalImage").src = source.src;
			document.getElementById("qrModalAmount").textContent = document.getElementById("pkrAmount").textContent;
			qrModal.hidden = false;
			document.body.style.overflow = "hidden";
			document.getElementById("qrModalClose").focus();
		}

		function closeQr() {
			qrModal.hidden = true;
			document.body.style.overflow = "";
			qrZoom.focus();
		}

		qrZoom.addEventListener("click", openQr);
		document.getElementById("qrModalClose").addEventListener("click", closeQr);
		qrModal.addEventListener("click", function (event) {
			if (event.target === qrModal) closeQr();
		});
		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape" && !qrModal.hidden) closeQr();
		});

		function readProof(file) {
			return new Promise(function (resolve, reject) {
				if (!file) return resolve("");
				if (file.size > 4 * 1024 * 1024) return reject(new Error("The screenshot must be smaller than 4 MB."));
				if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
					return reject(new Error("Upload a JPG, PNG or WebP screenshot."));
				}
				var reader = new FileReader();
				reader.onload = function () { resolve(String(reader.result || "")); };
				reader.onerror = function () { reject(new Error("The screenshot could not be read.")); };
				reader.readAsDataURL(file);
			});
		}

		document.getElementById("submitPayment").addEventListener("click", async function () {
			var button = this;
			var transaction = document.getElementById("transactionId").value.trim();
			showError("bankPayError", "");
			if (!currentOrder || !orderToken) return showError("bankPayError", "Start a new bank-payment order.");
			if (transaction.length < 4) return showError("bankPayError", "Enter the transaction ID shown by your bank or JazzCash.");
			busy(button, true, "Submitting securely…");
			try {
				var proof = await readProof(document.getElementById("paymentProof").files[0]);
				await request("/api/checkout/bank/orders/" + encodeURIComponent(currentOrder.reference) + "/submit", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ token: orderToken, transaction_id: transaction, proof_data: proof }),
				});
				document.getElementById("bankPay").hidden = true;
				document.getElementById("doneReference").textContent = currentOrder.reference;
				document.getElementById("bankDone").hidden = false;
			} catch (e) {
				showError("bankPayError", e.message);
			} finally {
				busy(button, false, "");
			}
		});
	})();
</script>

<style>
	.checkout-section { padding-top: clamp(44px, 7vw, 82px); }
	.checkout-head { max-width: 720px; margin-bottom: 30px; }
	.checkout-head h1 { margin: 7px 0 12px; }
	.eyebrow { color: var(--violet); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.checkout-grid { display: grid; grid-template-columns: minmax(280px, .85fr) minmax(0, 1.15fr); gap: 24px; align-items: start; }
	.card-panel { border: 1px solid var(--border-strong); border-radius: 20px; padding: clamp(22px, 4vw, 32px); background: var(--panel); box-shadow: var(--shadow); }
	.card-panel > h2 { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 22px; }
	.product-row { display: flex; gap: 18px; align-items: center; justify-content: space-between; padding: 20px; border-radius: 12px; background: var(--panel-strong); border: 1px solid var(--border); }
	.product-row div { display: grid; gap: 3px; }
	.product-row span { color: var(--dim); font-size: .83rem; }
	.product-row .price { color: var(--violet); font-size: 1.55rem; white-space: nowrap; }
	.summary-line { display: flex; justify-content: space-between; gap: 15px; padding: 17px 2px; color: var(--muted); border-bottom: 1px solid var(--border); }
	.summary-line.total { color: var(--text); font-size: 1.05rem; border-bottom: 0; }
	.summary-line.total strong { color: var(--violet); }
	.pkr-summary { padding: 10px 13px; border-radius: 9px; background: color-mix(in srgb, var(--violet) 9%, transparent); color: var(--muted); font-size: .82rem; }
	.trust-list { list-style: none; display: grid; gap: 9px; margin-top: 24px; color: var(--muted); font-size: .88rem; }
	.trust-list li::before { content: "✓"; color: var(--ok); font-weight: 800; margin-right: 9px; }
	.method-tabs { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 26px; border-bottom: 1px solid var(--border-strong); }
	.method-tab { appearance: none; border: 0; border-bottom: 3px solid transparent; background: transparent; color: var(--dim); padding: 13px 10px; font: inherit; font-weight: 750; cursor: pointer; }
	.method-tab.active { color: var(--violet); border-bottom-color: var(--violet); }
	.method-tab:focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; }
	.method-intro { display: flex; gap: 15px; align-items: center; padding: 24px; margin-bottom: 20px; border-radius: 14px; background: var(--panel-strong); }
	.method-intro p { color: var(--muted); font-size: .9rem; margin-top: 4px; }
	.method-icon { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border-radius: 12px; background: var(--grad-btn); color: white; font-size: 1.25rem; font-weight: 900; }
	.full { width: 100%; justify-content: center; text-align: center; }
	.local-note { display: grid; gap: 3px; padding: 14px 16px; margin-bottom: 20px; border-left: 3px solid var(--cyan); background: color-mix(in srgb, var(--cyan) 8%, transparent); border-radius: 8px; }
	.local-note span { color: var(--muted); font-size: .86rem; }
	.field { display: grid; gap: 7px; margin: 17px 0; }
	.field > span, .local-methods legend { color: var(--text); font-size: .79rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
	.field input { width: 100%; border: 1px solid var(--border-strong); border-radius: 10px; padding: 12px 13px; background: var(--bg); color: var(--text); font: inherit; }
	.field input:focus { outline: 2px solid color-mix(in srgb, var(--violet) 55%, transparent); border-color: var(--violet); }
	.field small { color: var(--dim); font-size: .78rem; }
	.field em { color: var(--dim); text-transform: none; font-weight: 500; }
	.local-methods { border: 0; display: grid; gap: 9px; margin: 20px 0; }
	.local-methods legend { margin-bottom: 8px; }
	.local-choice { display: flex; gap: 11px; align-items: center; padding: 13px 14px; border: 1px solid var(--border); border-radius: 11px; cursor: pointer; }
	.local-choice.selected { border-color: var(--violet); background: color-mix(in srgb, var(--violet) 7%, transparent); }
	.local-choice input { accent-color: var(--violet); }
	.local-choice span { display: grid; gap: 1px; }
	.local-choice small { color: var(--dim); }
	.quote-box { text-align: center; display: grid; gap: 5px; padding: 20px; border-radius: 14px; background: var(--stage); color: var(--stage-text); }
	.quote-box > span { color: var(--stage-muted); font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; }
	.quote-box strong { font-size: clamp(1.7rem, 5vw, 2.25rem); color: var(--cyan-bright); }
	.quote-box small { color: var(--stage-muted); }
	.order-ref { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin: 14px 0; padding: 11px 14px; border: 1px dashed var(--border-strong); border-radius: 9px; color: var(--muted); }
	.order-ref strong { color: var(--text); font-family: var(--mono); }
	.details-box { display: grid; grid-template-columns: minmax(0, 1fr) 150px; gap: 18px; padding: 18px; border: 1px solid var(--border); border-radius: 13px; background: var(--panel-strong); }
	.detail-copy h3 { margin-bottom: 13px; }
	.detail-copy dl { display: grid; gap: 10px; }
	.detail-copy dl div { display: grid; gap: 2px; }
	.detail-copy dt { color: var(--dim); font-size: .76rem; }
	.detail-copy dd { color: var(--text); overflow-wrap: anywhere; }
	.copy { margin-left: 7px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); color: var(--violet); padding: 3px 7px; cursor: pointer; }
	.bank-qr { display: grid; gap: 6px; width: 150px; padding: 0; border: 0; background: transparent; color: var(--dim); font: inherit; font-size: .72rem; text-align: center; cursor: zoom-in; }
	.bank-qr img { width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 9px; background: white; }
	.bank-qr[hidden] { display: none; }
	.bank-qr:hover span { color: var(--violet); }
	.bank-qr:focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; border-radius: 11px; }
	.qr-modal { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: 20px; background: rgba(8, 8, 13, .8); }
	.qr-modal[hidden] { display: none; }
	.qr-modal-card { display: grid; gap: 14px; justify-items: center; width: min(400px, 100%); padding: clamp(20px, 4vw, 28px); border: 1px solid var(--border-strong); border-radius: 18px; background: var(--panel); box-shadow: var(--shadow); }
	.qr-modal-card h2 { font-size: 1.05rem; }
	.qr-modal-card img { width: min(320px, 60vh, 100%); aspect-ratio: 1; object-fit: contain; padding: 10px; border-radius: 12px; background: white; }
	#qrModalAmount { color: var(--violet); font-size: 1.15rem; font-weight: 800; }
	.instruction { color: var(--muted); font-size: .87rem; margin: 17px 0; }
	.alert { margin-top: 14px; padding: 11px 13px; border-radius: 9px; font-size: .86rem; }
	.alert.error { color: #b42318; background: rgba(248, 113, 113, .11); border: 1px solid rgba(248, 113, 113, .32); }
	.alert.warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 10%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent); }
	.done { text-align: center; padding: 30px 10px; }
	.done-mark { width: 58px; height: 58px; margin: 0 auto 15px; display: grid; place-items: center; border-radius: 50%; background: rgba(52, 211, 153, .14); color: var(--ok); font-size: 1.7rem; font-weight: 900; }
	.done p { color: var(--muted); max-width: 47ch; margin: 8px auto; }
	.done-ref strong { color: var(--text); font-family: var(--mono); }
	@media (max-width: 860px) { .checkout-grid { grid-template-columns: 1fr; } }
	@media (max-width: 560px) {
		.checkout-section { padding-top: 34px; }
		.card-panel { border-radius: 15px; padding: 18px; }
		.method-tabs { grid-template-columns: 1fr; }
		.method-tab { text-align: left; }
		.details-box { grid-template-columns: 1fr; }
		.bank-qr { width: min(220px, 100%); margin: auto; }
		.product-row { align-items: flex-start; }
	}
</style>
