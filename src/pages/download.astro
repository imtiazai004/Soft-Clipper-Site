---
import Page from "../layouts/Page.astro";
import Faq from "../components/Faq.astro";
import { PRICE, PRODUCT, SITE } from "../consts";
import { faqSchema, howToSchema, breadcrumbSchema, type FaqItem } from "../lib/schema";

const crumbs = [
	{ label: "Home", href: "/" },
	{ label: "Download", href: "/download/" },
];

const steps = [
	{ name: "Download the installer", text: `${PRODUCT.installerSize}, straight from this page — you do not need a licence to download it.` },
	{ name: "Run the installer", text: "Double-click it and follow the wizard. Windows will warn about an unrecognised publisher the first time — choose More info, then Run anyway. It installs for you only, so there is no administrator prompt." },
	{ name: "Buy a licence", text: `Pay ${PRICE.display} once. Your key arrives by email within a minute.` },
	{ name: "Paste your key", text: "On first launch Soft Clipper asks for the licence key from your email. It activates online once and then works without a connection." },
	{ name: "Add your Gemini key", text: "In Settings, paste a Google Gemini API key. It is free to create, and it is what powers moment detection and transcription." },
];

const faqs: FaqItem[] = [
	{
		q: "Is there a free trial?",
		a: "No trial build, but there is a 14-day refund. Buy it, use it properly on a real video, and if it does not fit, email us for a full refund.",
	},
	{
		q: "Is there an installer?",
		a: "Yes, and it is the only way we ship it. It installs for you only, so Windows never asks for administrator rights, and it puts a proper entry in Add or Remove Programs. If you would rather not click past the SmartScreen warning, the email with your key also carries a terminal command that downloads and runs the same installer without one.",
	},
	{
		q: "Where does it install, and what does uninstalling remove?",
		a: "Into your own user folder, not Program Files — the app writes exported clips beside itself, and Windows does not allow that under Program Files. Uninstalling removes the app and its cached downloads but deliberately leaves your exported clips where they are.",
	},
	{
		q: "Windows says the publisher is unrecognised. Is that normal?",
		a: "Yes, on new releases. Code-signing reputation builds over time, and a fresh release starts without it. Choose More info and then Run anyway, or check the file on VirusTotal first if you would rather be sure.",
	},
	{
		q: "Where can I find my licence key again?",
		a: "In the purchase email. If it is gone, email support from the address you paid with and we will resend it.",
	},
	{
		q: "Can I install it on a second computer?",
		a: `Not on the same licence — ${PRODUCT.licence}. You can release the licence from one machine and activate it on another, which is the supported way to move to a new PC.`,
	},
	{
		q: "What are the system requirements?",
		a: `${PRODUCT.platforms}, ${PRODUCT.requirements}. Rendering uses your processor, so a faster CPU means faster exports, but no graphics card is required.`,
	},
];
---

<Page
	title="Download Soft Clipper"
	heading="Download and install"
	description={`Download Soft Clipper for ${PRODUCT.platforms}. Buy once for ${PRICE.display}, activate with your licence key, and start cutting vertical clips.`}
	intro={`Soft Clipper is a desktop app for ${PRODUCT.platforms}, delivered as a ${PRODUCT.installerSize} installer. There is no cloud account to create — the licence key in your purchase email is the whole setup.`}
	eyebrow="Download"
	crumbs={crumbs}
	schema={[
		faqSchema(faqs),
		breadcrumbSchema(crumbs),
		howToSchema({
			name: "How to install and activate Soft Clipper",
			description: "Buy a licence, install the app on Windows, activate it with your key and add a Gemini API key.",
			totalTime: "PT5M",
			steps,
		}),
	]}
>
	<section class="pt-0">
		<div class="wrap">
			{/*
			  The download link is not on this page any more.

			  It used to be, on the reasoning that the file is useless without a
			  licence key and pretending otherwise would be a claim anyone could
			  disprove by pasting the URL. That reasoning still holds for what the
			  link *protects* — this change hides it, it does not make the file
			  unreachable, and the R2 URL is still public to anyone who has it.

			  What it changes is who is handed it. A visitor who has not bought
			  now gets the price and an explanation instead of a 168 MB installer
			  they cannot run. Buyers get the link on the thank-you page and in the
			  licence email, which is where it was always most useful.

			  If this needs to become real gating rather than a quieter page, the
			  answer is a download that checks a key before it serves anything —
			  not this.
			*/}
			<div class="buy-box">
				<div>
					<h2>Buy a licence, then install it</h2>
					<p class="muted">
						The download arrives with your licence key, by email, the moment you buy.
						There is no separate account to make and nothing to wait for — the key in
						that email is the whole setup.
					</p>
				</div>
				{
					PRODUCT.downloadsEnabled ? (
						<Fragment>
							<div class="btn-row">
								<a class="btn btn-primary" href="/pricing/">Buy a licence — {PRICE.display}</a>
								<a class="btn btn-ghost" href="/help/install/">See how the install works</a>
							</div>
							<p class="small muted alt">
								{PRODUCT.platforms}. {PRODUCT.installerSize} for Windows
								{PRODUCT.macEnabled && `, ${PRODUCT.macSize} for macOS`}. One licence covers
								one computer, and you can move it to another one whenever you like.
							</p>
							<p class="small muted alt">
								Already bought? Your download link is in the email with your key —
								or <a href={`mailto:${SITE.email}`}>email us</a> and we will resend it.
							</p>
						</Fragment>
					) : (
						/*
						 * Downloads switched off from the dashboard — a broken build, or
						 * mid-release. It says why and offers a person, rather than
						 * hiding the button and leaving the page looking broken. The buy
						 * link is deliberately gone too: selling a licence for software
						 * nobody can install is how a refund starts.
						 */
						<Fragment>
							<div class="paused">
								<p><strong>{PRODUCT.downloadsOffMessage}</strong></p>
								<p class="small">
									Already bought? Your licence is safe and your key still works — email{" "}
									<a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we will send you the
									installer directly.
								</p>
							</div>
						</Fragment>
					)
				}
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<div class="section-head"><h2>Setting it up</h2></div>
			<ol class="steps">
				{
					steps.map((s) => (
						<li>
							<h3>{s.name}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
			<p class="mt-lg">
				<a href="/help/install/">Detailed install guide</a> ·
				<a href="/help/activate-licence/">Licence activation help</a> ·
				<a href="/help/troubleshooting/">Troubleshooting</a>
			</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<div class="card req">
				<h2>Requirements</h2>
				<dl>
					<dt>Operating system</dt><dd>{PRODUCT.platforms}</dd>
					<dt>Memory</dt><dd>{PRODUCT.requirements}</dd>
					<dt>Disk</dt><dd>A few GB free — source videos and rendered clips are large</dd>
					<dt>Internet</dt><dd>For activation and AI analysis only; rendering is offline</dd>
					<dt>Licence</dt><dd>{PRODUCT.licence}</dd>
				</dl>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap wrap-narrow">
			<Faq items={faqs} />
		</div>
	</section>
</Page>

<style>
	.paused {
		border: 1px solid var(--warn);
		background: color-mix(in srgb, var(--warn) 10%, transparent);
		border-radius: var(--radius-sm);
		padding: 16px 18px;
		max-width: 60ch;
	}
	.paused p {
		margin: 0;
	}
	.paused p + p {
		margin-top: 8px;
		color: var(--muted);
	}

	.pt-0 {
		padding-top: 8px;
	}
	.buy-box {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
		padding: 32px;
		border: 1px solid var(--border-strong);
		border-radius: 20px;
		background: var(--panel);
	}
	.buy-box h2 {
		font-size: 1.3rem;
		margin-bottom: 8px;
	}
	.buy-box p {
		max-width: 46ch;
	}
	.req h2 {
		font-size: 1.2rem;
		margin-bottom: 16px;
	}
	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 10px 20px;
		font-size: 0.95rem;
	}
	dt {
		color: var(--dim);
	}
	dd {
		color: var(--muted);
	}
	@media (max-width: 560px) {
		dl {
			grid-template-columns: 1fr;
			gap: 2px;
		}
		dt {
			margin-top: 10px;
		}
	}
</style>
