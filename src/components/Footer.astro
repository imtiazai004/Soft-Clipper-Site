---
import { SITE, PRICE, PRODUCT } from "../consts";

/*
 * The footer is the site's internal-linking backbone — every important page is
 * reachable from every page, which is how crawlers find the deeper ones — but a
 * backbone is not a sitemap. Five columns of everything reads as a dumped
 * directory, so the legal pages live in the bottom bar where people look for
 * them anyway, and what is left fits four tight columns beside the brand.
 */
const columns = [
	{
		title: "Product",
		links: [
			{ href: "/features/", label: "Features" },
			{ href: "/features/auto-reframe/", label: "Auto-reframe to 9:16" },
			{ href: "/features/ai-moment-detection/", label: "AI moment detection" },
			{ href: "/features/captions/", label: "Auto captions" },
			{ href: "/features/highlight-reel/", label: "Highlight reels" },
			{ href: "/pricing/", label: `Pricing — ${PRICE.display} once` },
			{ href: "/download/", label: "Download" },
		],
	},
	{
		title: "Use cases",
		links: [
			{ href: "/use-cases/podcasters/", label: "Podcasters" },
			{ href: "/use-cases/youtubers/", label: "YouTubers" },
			{ href: "/use-cases/coaches/", label: "Coaches & creators" },
			{ href: "/use-cases/agencies/", label: "Agencies" },
			{ href: "/blog/", label: "Blog" },
			{ href: "/about/", label: "About" },
			{ href: "/affiliates/", label: "Affiliate programme" },
		],
	},
	{
		title: "Compare",
		links: [
			{ href: "/compare/opus-clip-alternative/", label: "vs Opus Clip" },
			{ href: "/compare/klap-alternative/", label: "vs Klap" },
			{ href: "/compare/vizard-alternative/", label: "vs Vizard" },
			{ href: "/compare/capcut-alternative/", label: "vs CapCut" },
			{ href: "/compare/one-time-vs-subscription/", label: "One-time vs subscription" },
		],
	},
	{
		title: "Support",
		links: [
			{ href: "/help/", label: "Help centre" },
			{ href: "/help/install/", label: "Install guide" },
			{ href: "/help/activate-licence/", label: "Activate your licence" },
			{ href: "/help/troubleshooting/", label: "Troubleshooting" },
			{ href: "/faq/", label: "FAQ" },
			{ href: "/contact/", label: "Contact" },
		],
	},
];

const legal = [
	{ href: "/legal/privacy/", label: "Privacy" },
	{ href: "/legal/terms/", label: "Terms" },
	{ href: "/legal/refund/", label: "Refunds" },
];

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<div class="cols">
			<div class="about">
				<span class="brand">
					<span class="mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="4" width="11" height="16" rx="2"></rect>
							<path d="M17 8v8"></path>
							<path d="M21 6v12"></path>
						</svg>
					</span>
					{SITE.name}
				</span>
				<p class="blurb">
					{PRODUCT.appNoun.charAt(0).toUpperCase() + PRODUCT.appNoun.slice(1)} that turns long videos into ready-to-post vertical clips. Pay once,
					use forever.
				</p>
				<div class="contact">
					<a href={`mailto:${SITE.email}`}>
						<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="4" width="20" height="16" rx="2"></rect>
							<path d="m2 7 10 6 10-6"></path>
						</svg>
						{SITE.email}
					</a>
					<a href={SITE.waLink} target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
							<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.7 6.7 0 0 1-2-1.2 7.5 7.5 0 0 1-1.4-1.7c-.1-.3 0-.4.1-.5l.4-.4.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1A4.9 4.9 0 0 0 8 14.7a11 11 0 0 0 4.2 3.7 8.6 8.6 0 0 0 1.4.5 3.4 3.4 0 0 0 1.6.1 2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"></path>
						</svg>
						{SITE.phone}
					</a>
				</div>
			</div>

			{
				columns.map((col) => (
					<nav aria-label={col.title}>
						<h2>{col.title}</h2>
						<ul>
							{col.links.map((l) => (
								<li>
									<a href={l.href}>{l.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="base">
			{/* The trading disclosure. It belongs on every page, which is what a
			    footer is for — not only in the terms, where nobody looks. */}
			<p class="legalline">
				&copy; {year} {SITE.company}
				<span class="sep" aria-hidden="true">·</span>
				<span>Registered in {SITE.companyRegisteredIn} no. {SITE.companyNumber}</span>
				<span class="sep" aria-hidden="true">·</span>
				<span>{SITE.companyAddressLine}</span>
			</p>
			<nav class="legal" aria-label="Legal">
				{legal.map((l) => <a href={l.href}>{l.label}</a>)}
			</nav>
		</div>

		<p class="disclaimer">
			Soft Clipper is an independent product and is not affiliated with, endorsed by or
			connected to TikTok, YouTube, Instagram or any of the tools it is compared with.
			Process only video you own or have the right to use.
		</p>
	</div>
</footer>

<style>
	/*
	 * The footer picks up the same two ideas the rest of the site runs on: the
	 * violet-to-cyan gradient, and light held against a glow. It is the last
	 * thing on every page, so it should look like it belongs to the product
	 * rather than like the place the page ran out.
	 */
	footer {
		position: relative;
		overflow: hidden;
		margin-top: 40px;
		padding-block: 52px 26px;
		background: linear-gradient(180deg, transparent, rgba(109, 63, 224, 0.05));
	}

	/* The brand gradient as a hairline, faded out at both ends so it reads as a
	   horizon rather than a rule stopping dead at the window edge. */
	footer::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--violet) 22%, var(--cyan) 78%, transparent);
		opacity: 0.55;
	}

	/* The same ambient wash as the page, low and wide, so the block has depth
	   without a hard panel edge. */
	footer::after {
		content: "";
		position: absolute;
		z-index: 0;
		left: 50%;
		bottom: -60%;
		width: min(1100px, 120%);
		aspect-ratio: 2 / 1;
		translate: -50% 0;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--glow-a), transparent 72%);
		pointer-events: none;
	}

	footer > :global(.wrap) {
		position: relative;
		z-index: 1;
	}

	/* A fixed number of tracks, on purpose.
	   This was `1.4fr repeat(auto-fit, minmax(150px, 1fr))`, which is invalid —
	   repeat(auto-fit) cannot sit in a track list that also has an fr elsewhere —
	   so the whole declaration was dropped and every browser fell back to one
	   column. That is what made the footer 1,500px of stacked links. */
	.cols {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) repeat(4, minmax(0, 1fr));
		gap: 36px 34px;
	}

	/* One rule, between who we are and where to go. Four rules between four
	   columns would read as a table; none at all let the whole block run
	   together, which is what it was doing. */
	.about {
		display: grid;
		gap: 10px;
		align-content: start;
		max-width: 32ch;
		padding-right: 34px;
		border-right: 1px solid var(--border);
	}
	/* The same mark as the nav, so the page closes with the thing it opened
	   with. */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-weight: 800;
		letter-spacing: -0.02em;
		font-size: 1.02rem;
	}
	.mark {
		width: 29px;
		height: 29px;
		flex: none;
		border-radius: 9px;
		background: var(--grad);
		color: #fff;
		display: grid;
		place-items: center;
		box-shadow: 0 4px 14px rgba(91, 45, 214, 0.26);
	}

	.blurb {
		font-size: 0.855rem;
		line-height: 1.55;
		color: var(--muted);
	}

	/* Chips rather than bare links: these are the two ways to reach a person,
	   and they should look reachable. */
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-top: 2px;
	}
	.contact a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 5px 11px;
		border-radius: 9px;
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--muted);
		text-decoration: none;
		font-size: 0.8rem;
		transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}
	.contact a:hover {
		color: var(--text);
		border-color: var(--border-strong);
		transform: translateY(-1px);
	}
	.contact svg {
		flex: none;
		opacity: 0.75;
	}

	/* A short gradient stroke over each heading — the site's one piece of
	   decoration, used four times and nowhere else down here. */
	h2 {
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--dim);
		font-weight: 700;
		margin-bottom: 12px;
	}
	h2::before {
		content: "";
		display: block;
		width: 20px;
		height: 2px;
		margin-bottom: 10px;
		border-radius: 2px;
		background: var(--grad);
	}

	ul {
		list-style: none;
		display: grid;
		gap: 11px;
	}
	ul a {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.865rem;
		line-height: 1.4;
		transition: color 0.15s ease, transform 0.15s ease;
	}
	ul a:hover {
		color: var(--text);
		transform: translateX(3px);
	}

	/* Copyright left, legal right, one line — where everyone looks for them. */
	.base {
		margin-top: 46px;
		padding-top: 22px;
		border-top: 1px solid var(--border);
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px 20px;
		font-size: 0.83rem;
		color: var(--muted);
	}
	.sep {
		margin-inline: 7px;
		opacity: 0.5;
	}
	.legal {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.legal a {
		position: relative;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.legal a:hover {
		color: var(--text);
	}
	/* Separators drawn rather than typed, so there is no stray dot after the
	   last one and nothing for a screen reader to read out. */
	.legal a + a::before {
		content: "";
		position: absolute;
		left: -9px;
		top: 50%;
		width: 2px;
		height: 2px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.45;
	}

	/* Small print, and it should look like small print rather than a fourth
	   paragraph competing with the rest. */
	.disclaimer {
		margin-top: 22px;
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--dim);
		max-width: 76ch;
		opacity: 0.85;
	}

	@media (max-width: 900px) {
		.cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 30px 22px;
		}
		/* Full width, so the rule that separated it from the columns has nothing
		   left to separate. */
		.about {
			grid-column: 1 / -1;
			max-width: none;
			padding-right: 0;
			padding-bottom: 26px;
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}
	}

	/* The floating WhatsApp button is fixed to the bottom-right of the viewport,
	   which means that at the end of the page it sits on top of the last thing
	   in the footer. On a phone that was the disclaimer, with the right-hand end
	   of two lines under the button. This is the room it needs. */
	@media (max-width: 640px) {
		footer {
			padding-bottom: 88px;
		}
	}

	@media (max-width: 460px) {
		.base {
			justify-content: flex-start;
		}
	}
</style>
