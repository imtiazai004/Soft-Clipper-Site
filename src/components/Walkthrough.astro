---
/**
 * A tour of the app, driven by scroll.
 *
 * One window frame is pinned to the middle of the screen and held there while
 * the section scrolls past. Inside it, the screenshots cross-fade one into the
 * next with a slow push-in, each with its own caption and a counter — so the
 * reader scrolls once and watches the whole app go by inside a frame that never
 * moves.
 *
 * There is no JavaScript. The whole thing is scroll-driven CSS: the tall outer
 * element names a view timeline, and every animated part is given a slice of
 * that timeline to play across. Where the browser cannot drive animations from
 * scroll — and on phones, where pinning a frame just steals the scroll — the
 * base styles below take over and the same screenshots read as a plain
 * captioned list. Nothing is hidden behind the effect.
 *
 * To add a stop: drop the image in public/shots and add a line to `stops`. The
 * timing slices are computed from the length, so nothing else needs touching.
 */
import fs from "node:fs";
import path from "node:path";
import { imageSize } from "../lib/imageSize";

const shot = (name: string) => {
	const jpg = `${name}.jpg`;
	if (fs.existsSync(path.resolve("public/shots", jpg))) return `/shots/${jpg}`;
	const png = `${name}.png`;
	return fs.existsSync(path.resolve("public/shots", png)) ? `/shots/${png}` : null;
};

const stops = [
	{
		img: "step-1",
		where: "Video source",
		title: "Paste a link, or drop the file in",
		body: "Nothing is uploaded. The video stays on your disk and everything after this runs on your own machine.",
	},
	{
		img: "step-2",
		where: "Moments",
		title: "Every moment scored, and told why",
		body: "It reads the whole transcript and comes back with the parts worth posting — each with a hook title, a reason and hashtags.",
	},
	{
		img: "step-2b",
		where: "Moments",
		title: "Untick what you do not want",
		body: "Then cut the rest in one go. Six clips from one recording is a normal afternoon's posting done in a few minutes.",
	},
	{
		img: "step-3",
		where: "Clip settings",
		title: "Six ways to fill a vertical frame",
		body: "Smart crop follows the speaker. Fit and blur keeps the whole shot. Split, centre, gameplay and manual are there when the footage needs them.",
	},
	{
		img: "step-3b",
		where: "Clip settings",
		title: "Captions burned in, not attached",
		body: "Pick a style, set the words per line, turn on word-by-word highlighting. They survive every re-upload because they are part of the picture.",
	},
	{
		img: "step-4",
		where: "Generated clips",
		title: "Finished clips, ready to post",
		body: "Every clip cut, reframed and captioned, with the caption text and hashtags written for you — and the whole batch downloads as one ZIP.",
	},
].map((s) => {
	const src = shot(s.img);
	return { ...s, src, size: src ? imageSize(src) : null };
});

const n = stops.length;
const total = String(n).padStart(2, "0");

/**
 * Each stop owns a slice of the scroll, overlapping its neighbours slightly so
 * one image is always on its way in while the last is on its way out.
 */
const OVERLAP = 3;
const band = 100 / n;
const slice = (i: number) => {
	const from = Math.max(0, i * band - OVERLAP);
	const to = Math.min(100, (i + 1) * band + OVERLAP);
	return `animation-range: contain ${from.toFixed(2)}% contain ${to.toFixed(2)}%;`;
};

// One viewport to read the frame in, plus a screenful of scroll per stop.
const pinHeight = `calc(100vh + ${n} * 72vh)`;
---

<section class="tour" aria-label="A tour of Soft Clipper">
	<div class="pin" style={`--pin:${pinHeight}`}>
		<div class="stage">
			<div class="orbs" aria-hidden="true"><i class="o1"></i><i class="o2"></i></div>

			<div class="frame">
				<header class="chrome">
					<span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
					<span class="where mono">
						{
							stops.map((s, i) => (
								<span class={`w ${i === 0 ? "first" : ""} ${i === n - 1 ? "last" : ""}`} style={slice(i)}>
									Soft Clipper — {s.where}
								</span>
							))
						}
					</span>
				</header>

				<div class="os">
					{
						stops.map((s, i) => (
							<figure class={`shot ${i === 0 ? "first" : ""} ${i === n - 1 ? "last" : ""}`} style={slice(i)}>
								<div class="pic">
									{s.src ? (
										<>
											{/*
											  A blurred copy of the same image fills the frame behind the
											  sharp one. The app's sidebar is tall and narrow and its clip
											  list is wide; without this, half the stops would be a small
											  picture stranded on a flat rectangle.
											*/}
											<img
												class="haze"
												src={s.src}
												alt=""
												aria-hidden="true"
												width={s.size?.width}
												height={s.size?.height}
												loading="lazy"
												decoding="async"
											/>
											<img
												class="real"
												src={s.src}
												alt={s.title}
												width={s.size?.width}
												height={s.size?.height}
												loading={i < 2 ? "eager" : "lazy"}
												decoding="async"
											/>
										</>
									) : (
										<span class="missing mono">{s.where}</span>
									)}
								</div>
								<figcaption class="cap">
									<span class="num mono">{String(i + 1).padStart(2, "0")} / {total}</span>
									<b>{s.title}</b>
									<span class="body">{s.body}</span>
								</figcaption>
							</figure>
						))
					}
				</div>

				<div class="progress" aria-hidden="true"><i></i></div>
			</div>

			<span class="cue mono" aria-hidden="true">Scroll</span>
		</div>
	</div>
</section>

<style>
	/* ── base: no pinning, no motion ──────────────────────────────────────────
	   This is what phones get, and what any browser that cannot drive an
	   animation from scroll position gets: the same six screenshots as a plain
	   captioned list inside one window frame. The tour below is an enhancement
	   on top of it, never a requirement. */

	.tour {
		padding-inline: clamp(14px, 4vw, 32px);
	}

	.stage {
		display: grid;
		justify-items: center;
	}

	.frame {
		position: relative;
		width: min(1120px, 100%);
		border-radius: 18px;
		overflow: hidden;
		background: var(--stage);
		border: 1px solid var(--stage-border);
		box-shadow: 0 40px 90px rgba(12, 9, 40, 0.28);
	}

	.chrome {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--stage-border);
		background: rgba(255, 255, 255, 0.04);
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		flex: none;
		background: #4b4763;
	}
	.dot.r { background: #ff5f57; }
	.dot.y { background: #febc2e; }
	.dot.g { background: #28c840; }

	.where {
		position: relative;
		margin-left: 10px;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		color: var(--stage-muted);
	}
	/* In the static version the chrome carries the app's name once, not a label
	   per screenshot — the labels belong to the animated tour. */
	.where .w:not(:first-child) {
		display: none;
	}

	.os {
		display: grid;
	}

	.shot {
		margin: 0;
		display: grid;
		gap: 0;
		border-bottom: 1px solid var(--stage-border);
	}
	.shot:last-child {
		border-bottom: 0;
	}

	.pic {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #08071a;
	}
	.pic img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.haze {
		object-fit: cover;
		filter: blur(38px) saturate(1.5);
		opacity: 0.45;
		transform: scale(1.3);
	}
	/* scale-down, not contain: these are screenshots, and stretching one to fill
	   the frame only invents blur. Anything larger than the frame is fitted to
	   it; anything smaller is left at its own size, sharp, on the blurred
	   backdrop. */
	.real {
		object-fit: scale-down;
	}
	.missing {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		font-size: 0.72rem;
		color: var(--stage-muted);
	}

	.cap {
		display: grid;
		gap: 4px;
		padding: 16px 18px 20px;
		color: var(--stage-text);
	}
	.num {
		font-size: 0.66rem;
		letter-spacing: 0.18em;
		color: var(--cyan-bright);
	}
	.cap b {
		font-size: clamp(1.05rem, 2.2vw, 1.35rem);
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.cap .body {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--stage-muted);
		max-width: 62ch;
	}

	.orbs,
	.progress,
	.cue {
		display: none;
	}

	/* On a narrow screen there is no room to letterbox anything: every shot runs
	   the full width of the frame at its own proportions, and the blurred
	   backdrop has no gap left to fill. */
	@media (max-width: 860px) {
		.pic {
			aspect-ratio: auto;
		}
		.pic .haze {
			display: none;
		}
		.pic .real {
			position: static;
			width: 100%;
			height: auto;
			object-fit: fill;
		}
	}

	/* ── the tour ─────────────────────────────────────────────────────────────
	   Everything from here is only switched on where the browser can drive an
	   animation from scroll position, the screen is wide enough for a pinned
	   frame, and the reader has not asked for less motion. */

	@supports (animation-timeline: view()) {
		@media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
			.pin {
				position: relative;
				height: var(--pin);
				/* The timeline every animation below plays across: it runs from the
				   moment this block covers the viewport to the moment it stops. */
				view-timeline-name: --tour;
			}

			.stage {
				position: sticky;
				top: 0;
				height: 100vh;
				align-content: center;
				overflow: hidden;
			}

			/* Ambient colour behind the frame, so the pinned screen is not a grey
			   box for six screenfuls. */
			.orbs {
				display: block;
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			.orbs i {
				position: absolute;
				border-radius: 50%;
				filter: blur(90px);
			}
			.o1 {
				width: 46vw;
				height: 46vw;
				top: -14vh;
				left: -8vw;
				background: rgba(139, 92, 246, 0.18);
			}
			.o2 {
				width: 40vw;
				height: 40vw;
				right: -6vw;
				bottom: -18vh;
				background: rgba(34, 211, 238, 0.16);
			}

			/* An explicit height, because every screenshot inside is positioned and
			   so none of them can give the frame one. */
			.frame {
				--cap-space: 158px;
				width: min(1120px, 92vw);
				height: min(84vh, 760px);
				display: grid;
				grid-template-rows: auto 1fr auto;
			}

			.where .w {
				display: block;
				animation: label linear both;
				animation-timeline: --tour;
			}
			.where .w.first { animation-name: label-first; }
			.where .w.last { animation-name: label-last; }
			.where .w:not(.first) {
				position: absolute;
				inset: 0;
				opacity: 0;
			}

			.os {
				position: relative;
				min-height: 0;
			}

			.shot {
				position: absolute;
				inset: 0;
				display: block;
				border-bottom: 0;
				opacity: 0;
				animation: pass linear both;
				animation-timeline: --tour;
				will-change: opacity, transform;
			}
			.shot.first { animation-name: pass-first; }
			.shot.last { animation-name: pass-last; }

			.pic {
				position: absolute;
				inset: 0;
				aspect-ratio: auto;
			}
			/* The sharp image is held above the caption strip, so the card is never
			   sitting on top of the app's own interface. Width and height have to
			   go back to auto or the four insets are ignored, the image is sized by
			   its own proportions, and object-fit has nothing left to do. */
			/* Height, not a bottom inset: `auto` on a replaced element means its own
			   intrinsic size, so insets alone leave the image at natural size in the
			   top-left corner with object-fit having nothing to do. */
			.pic .real {
				height: calc(100% - var(--cap-space));
			}

			.cap {
				position: absolute;
				left: clamp(18px, 3vw, 34px);
				right: clamp(18px, 3vw, 34px);
				bottom: 16px;
				max-width: 780px;
				padding: 14px 18px;
				border-radius: 14px;
				background: rgba(10, 8, 26, 0.62);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}
			.cap .body {
				max-width: 78ch;
			}

			/* A measure of how far through the tour you are. */
			.progress {
				display: block;
				height: 3px;
				background: rgba(255, 255, 255, 0.08);
			}
			.progress i {
				display: block;
				height: 100%;
				background: var(--grad);
				transform: scaleX(0);
				transform-origin: left;
				animation: fill linear both;
				animation-timeline: --tour;
				animation-range: contain 0% contain 100%;
			}

			.cue {
				display: block;
				position: absolute;
				bottom: 3.5vh;
				left: 50%;
				translate: -50% 0;
				font-size: 0.64rem;
				letter-spacing: 0.28em;
				text-transform: uppercase;
				color: var(--muted);
				animation: cue linear both;
				animation-timeline: --tour;
				animation-range: contain 0% contain 7%;
			}
		}
	}

	/* Cross-fade with a slow push-in. The first stop starts already visible and
	   the last one stays; the ones between do both. */
	@keyframes pass {
		0% { opacity: 0; transform: scale(1); }
		16%, 84% { opacity: 1; }
		100% { opacity: 0; transform: scale(1.06); }
	}
	@keyframes pass-first {
		0% { opacity: 1; transform: scale(1); }
		84% { opacity: 1; }
		100% { opacity: 0; transform: scale(1.06); }
	}
	@keyframes pass-last {
		0% { opacity: 0; transform: scale(1); }
		16% { opacity: 1; }
		100% { opacity: 1; transform: scale(1.06); }
	}

	@keyframes label {
		0%, 100% { opacity: 0; }
		18%, 82% { opacity: 1; }
	}
	@keyframes label-first {
		0%, 82% { opacity: 1; }
		100% { opacity: 0; }
	}
	@keyframes label-last {
		0% { opacity: 0; }
		18%, 100% { opacity: 1; }
	}
	@keyframes fill {
		to { transform: scaleX(1); }
	}
	@keyframes cue {
		to { opacity: 0; translate: -50% 12px; }
	}
</style>
