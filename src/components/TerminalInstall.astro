---
/**
 * The install that shows no security warning at all.
 *
 * Both warnings people hit come from a flag the *browser* attaches to the file:
 * `com.apple.quarantine` on macOS, the Mark of the Web on Windows. Gatekeeper
 * and SmartScreen read that flag and act on it. `curl` and `Invoke-WebRequest`
 * do not set it, so a file fetched that way is not marked, and neither warning
 * has anything to fire on. Nothing is being bypassed — there is nothing there
 * to bypass. Confirmed by downloading the real installer with Invoke-WebRequest
 * and finding no Zone.Identifier stream on it.
 *
 * Offered second, never first. Two reasons.
 *
 * Most buyers will not open a terminal, and telling them to is a worse first
 * impression than a warning they can click past.
 *
 * And "paste this command to fix your problem" is the exact shape of a live
 * attack — fake error pages that talk people into pasting a command have been
 * one of the more effective ways to infect a machine. Teaching a customer that
 * habit is not a favour, so the commands here are plain and readable, with
 * nothing piped into a shell, and every line does something you can see.
 */
import { PRODUCT, SITE } from "../consts";

interface Props {
	os: "windows" | "mac";
	/** `full` explains itself; `compact` sits under a download button. */
	variant?: "full" | "compact";
}
const { os, variant = "full" } = Astro.props;

const mac = `curl -L -o ~/Downloads/soft-clipper.dmg \\
  ${PRODUCT.macUrl}
hdiutil attach ~/Downloads/soft-clipper.dmg
cp -R "/Volumes/Soft Clipper/Soft Clipper.app" /Applications/
hdiutil detach "/Volumes/Soft Clipper"
open "/Applications/Soft Clipper.app"`;

const windows = `Invoke-WebRequest "${PRODUCT.installerUrl}" \`
  -OutFile "$env:TEMP\\soft-clipper-setup.exe"
& "$env:TEMP\\soft-clipper-setup.exe"`;

const command = os === "mac" ? mac : windows;
const shell = os === "mac" ? "Terminal" : "PowerShell";
const guide = os === "mac" ? "/help/install-mac/" : "/help/install/";
const warning = os === "mac" ? "macOS shows no security warning" : "SmartScreen shows nothing";
---

<div class:list={["term", variant]}>
	<div class="head">
		<h3>{variant === "compact" ? `Install from ${shell} — no warnings` : "Prefer no warnings at all?"}</h3>
		<button class="copy" type="button" data-copy aria-label={`Copy the ${shell} command`}>Copy</button>
	</div>

	{
		variant === "full" && (
			<p>
				Paste this into {shell} instead. {warning}, because the warning comes from a flag your
				browser attaches to downloads and {os === "mac" ? "curl" : "PowerShell"} does not
				attach one.
			</p>
		)
	}

	<pre><code data-command>{command}</code></pre>

	{
		variant === "full" ? (
			<Fragment>
				<p class="small">
					{
						os === "mac"
							? "Line one downloads the disk image, line two opens it, line three copies the app into Applications, line four closes the image again, line five starts it."
							: "Line one downloads the installer, line two runs it. The installer itself is unchanged."
					}
					{" "}Nothing here is piped into a shell — read each line before you run it, here and
					anywhere else. If a website ever tells you to paste a command you cannot read, do not.
				</p>
				<p class="small muted">
					Not sure? Use the normal download above. Both give you exactly the same app, and the
					warning is safe to click past — <a href={guide}>the install guide</a> shows how, or{" "}
					<a href={SITE.waLink}>message us</a> and we will walk you through it.
				</p>
			</Fragment>
		) : (
			<p class="small muted">
				Same app as the button above. <a href={guide}>What the warning is</a>, if you would
				rather just click past it.
			</p>
		)
	}
</div>

<script is:inline>
	document.querySelectorAll("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const code = btn.closest(".term")?.querySelector("[data-command]");
			if (!code) return;
			try {
				await navigator.clipboard.writeText(code.textContent || "");
				btn.textContent = "Copied";
			} catch {
				// Clipboard access needs a secure context and permission. Selecting
				// the text is a worse experience than copying it, but it is far
				// better than a button that silently does nothing.
				const range = document.createRange();
				range.selectNodeContents(code);
				const sel = window.getSelection();
				sel?.removeAllRanges();
				sel?.addRange(range);
				btn.textContent = "Press Ctrl+C";
			}
			setTimeout(() => (btn.textContent = "Copy"), 2500);
		});
	});
</script>

<style>
	.term {
		margin-top: 28px;
		padding: 20px 22px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--panel-strong);
	}
	.term.compact {
		margin-top: 18px;
		padding: 16px 18px;
	}
	.head {
		display: flex;
		align-items: center;
		gap: 12px;
		justify-content: space-between;
		margin-bottom: 8px;
	}
	.term h3 {
		margin: 0;
		font-size: 1.02rem;
	}
	.term.compact h3 {
		font-size: 0.94rem;
	}
	.copy {
		flex-shrink: 0;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 5px 13px;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: var(--panel);
		color: var(--text);
		cursor: pointer;
	}
	.copy:hover {
		border-color: var(--violet);
		color: var(--violet);
	}
	.term p {
		margin: 0 0 12px;
		color: var(--muted);
		font-size: 0.94rem;
	}
	.term p.small {
		font-size: 0.84rem;
		margin-top: 12px;
		margin-bottom: 0;
	}
	.term p.small + p.small {
		margin-top: 8px;
	}
	pre {
		margin: 0;
		padding: 14px 16px;
		border-radius: var(--radius-sm);
		background: var(--stage);
		color: var(--stage-text);
		/* Commands must not wrap: a line broken across two, pasted into a shell,
		   is a command that does something other than what it looks like. */
		overflow-x: auto;
	}
	code {
		font-family: var(--mono);
		font-size: 0.82rem;
		line-height: 1.6;
		white-space: pre;
	}
</style>
