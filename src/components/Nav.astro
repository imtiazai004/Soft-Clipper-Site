---
import { NAV, SITE } from "../consts";

const { pathname } = Astro.url;
// A link is "current" when the page sits under it, so /features/captions/ still
// highlights Features. Screen readers get aria-current, not just a colour.
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header>
	<a class="skip" href="#main">Skip to content</a>
	<div class="wrap bar">
		<a class="brand" href="/">
			<span class="mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="11" height="16" rx="2"></rect>
					<path d="M17 8v8"></path>
					<path d="M21 6v12"></path>
				</svg>
			</span>
			<span class="name">{SITE.name}</span>
		</a>

		{/*
		  Every link is in the HTML, always — nothing here is built by script.
		  A menu that only exists once JavaScript has run is a menu a crawler
		  never sees, and these are the pages the site most wants indexed.

		  Each group is a link *and* a button, not a link doing both jobs. The
		  link goes to the section's own page for somebody who knows where they
		  are going; the button opens the panel for somebody who does not, and is
		  the part that works with a keyboard and on a touchscreen, where there is
		  no such thing as hover.
		*/}
		<nav aria-label="Main">
			<ul>
				{
					NAV.map((item) => {
						const current = isActive(item.href);
						const children = "children" in item ? item.children : null;
						const id = `menu-${item.href.replace(/\W+/g, "-")}`;
						return (
							<li class={children ? "grp" : undefined}>
								<span class="top">
									<a href={item.href} aria-current={current ? "page" : undefined}>
										{item.label}
									</a>
									{children && (
										<button
											class="caret"
											type="button"
											aria-expanded="false"
											aria-controls={id}
											aria-label={`Show what is under ${item.label}`}
										>
											<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="m6 9 6 6 6-6"></path>
											</svg>
										</button>
									)}
								</span>
								{children && (
									<div class="panel" id={id}>
										<ul class="panel-list">
											{children.map((child) => (
												<li>
													<a href={child.href} aria-current={pathname === child.href ? "page" : undefined}>
														<strong>{child.label}</strong>
														<span>{child.note}</span>
													</a>
												</li>
											))}
											<li class="all">
												<a href={item.href}>{item.all} →</a>
											</li>
										</ul>
									</div>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>

		<button class="theme" type="button" id="theme-toggle" aria-label="Switch theme">
			<svg class="ic sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			</svg>
			<svg class="ic moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			</svg>
		</button>

		<a class="btn btn-primary buy" href="/pricing/">Get Soft Clipper</a>
	</div>
</header>

{/*
  is:inline for the same reason as the head script: this is the only other
  script on the site and bundling it would start shipping a JavaScript file to
  every page for one button.
*/}
<script is:inline>
	(function () {
		var root = document.documentElement;
		var button = document.getElementById("theme-toggle");
		var meta = document.getElementById("theme-color");
		if (!button) return;

		var PAGE = { light: "#ffffff", dark: "#0f0e1e" };

		function paint() {
			var dark = root.dataset.theme === "dark";
			// The label says what pressing it will do, not what is on screen.
			button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
			if (meta) meta.setAttribute("content", dark ? PAGE.dark : PAGE.light);
		}

		button.addEventListener("click", function () {
			var next = root.dataset.theme === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch (e) {
				/* No storage: the choice holds for this page only. */
			}
			paint();
		});

		paint();
	})();

	/**
	 * The menus.
	 *
	 * Opening on hover is done in CSS, and only where hovering is a real thing —
	 * see the `@media (hover: hover)` block below. This script is for everywhere
	 * hover is not: a keyboard, and a touchscreen, where the first tap on a
	 * hover-only menu either does nothing or follows the link past the menu you
	 * were trying to open.
	 *
	 * So the caret is a button and this toggles it. Escape closes and puts focus
	 * back, which is the one keyboard behaviour people actually reach for.
	 */
	(function () {
		var groups = [].slice.call(document.querySelectorAll("nav .grp"));
		if (!groups.length) return;

		function close(group) {
			group.classList.remove("open");
			var caret = group.querySelector(".caret");
			if (caret) caret.setAttribute("aria-expanded", "false");
		}

		function closeAll(except) {
			groups.forEach(function (g) {
				if (g !== except) close(g);
			});
		}

		groups.forEach(function (group) {
			var caret = group.querySelector(".caret");
			if (!caret) return;

			caret.addEventListener("click", function () {
				var open = group.classList.toggle("open");
				caret.setAttribute("aria-expanded", String(open));
				// One at a time. Two panels overlapping is the state where nobody
				// can tell which link belongs to which heading.
				if (open) closeAll(group);
			});
		});

		document.addEventListener("keydown", function (e) {
			if (e.key !== "Escape") return;
			var open = document.querySelector("nav .grp.open");
			if (!open) return;
			close(open);
			var caret = open.querySelector(".caret");
			if (caret) caret.focus();
		});

		// A click anywhere else means you are done with the menu. Includes clicks
		// on the page behind it, which is what most people try first.
		document.addEventListener("click", function (e) {
			if (!e.target.closest || !e.target.closest("nav .grp")) closeAll(null);
		});
	})();
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--nav-bg);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.skip {
		position: absolute;
		left: -9999px;
		top: 8px;
		background: var(--bg-soft);
		border: 1px solid var(--border-strong);
		padding: 8px 14px;
		border-radius: 8px;
	}
	.skip:focus {
		left: 16px;
		z-index: 60;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 68px;
	}

	/* ── theme toggle ────────────────────────────────────────────────────── */

	.theme {
		flex: none;
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}
	.theme:hover {
		color: var(--text);
		border-color: var(--border-strong);
		background: var(--panel-strong);
	}
	.theme:focus-visible {
		outline: 2px solid var(--violet);
		outline-offset: 2px;
	}
	.theme .ic {
		grid-area: 1 / 1;
	}

	/* The icon shown is the one you are about to get, not the one you are in —
	   a moon on a light page, a sun on a dark one. :global() because the theme
	   attribute lives on <html>, which is outside this component and so must not
	   be given a scoping attribute. */
	.theme .sun {
		display: none;
	}
	.theme .moon {
		display: block;
	}
	:global(:root[data-theme="dark"]) .theme .sun {
		display: block;
	}
	:global(:root[data-theme="dark"]) .theme .moon {
		display: none;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 800;
		letter-spacing: -0.02em;
		flex: none;
	}
	.mark {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--grad);
		color: #fff;
		display: grid;
		place-items: center;
		box-shadow: 0 4px 14px rgba(91, 45, 214, 0.28);
	}

	nav {
		margin-left: auto;
	}
	nav > ul {
		display: flex;
		gap: 2px;
		list-style: none;
	}
	nav > ul > li {
		position: relative;
	}

	/* The link and its caret read as one control, so they share a background and
	   the gap between them is not a dead strip that closes the menu. */
	.top {
		display: flex;
		align-items: center;
		border-radius: 9px;
		transition: background 0.15s ease;
	}
	.top > a {
		display: block;
		padding: 8px 10px;
		border-radius: 9px;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.94rem;
		font-weight: 550;
		white-space: nowrap;
		transition: color 0.15s ease;
	}
	.top:hover,
	.grp.open .top {
		background: var(--panel);
	}
	.top:hover > a,
	.grp.open .top > a {
		color: var(--text);
	}
	.top > a[aria-current="page"] {
		color: var(--text);
	}
	nav > ul > li:has(> .top > a[aria-current="page"]) .top {
		background: var(--panel-strong);
	}

	.caret {
		display: grid;
		place-items: center;
		padding: 8px 8px 8px 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
		border-radius: 9px;
	}
	.caret svg {
		transition: transform 0.18s ease;
	}
	.caret:focus-visible {
		outline: 2px solid var(--violet);
		outline-offset: -2px;
	}

	/* ── the panels ──────────────────────────────────────────────────────── */

	.panel {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 40;
		/* A transparent strip above the card, so a mouse travelling from the
		   label down to the first link never crosses a gap that closes it. */
		padding-top: 8px;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
	}
	.panel-list {
		list-style: none;
		width: max-content;
		max-width: min(420px, calc(100vw - 32px));
		padding: 8px;
		background: var(--panel);
		border: 1px solid var(--border-strong);
		border-radius: 14px;
		box-shadow: var(--shadow-lg);
	}
	.panel-list a {
		display: block;
		padding: 9px 12px;
		border-radius: 10px;
		text-decoration: none;
		color: var(--text);
		transition: background 0.13s ease;
	}
	.panel-list a:hover,
	.panel-list a:focus-visible {
		background: var(--panel-strong);
	}
	.panel-list strong {
		display: block;
		font-size: 0.92rem;
		font-weight: 650;
	}
	.panel-list span {
		display: block;
		margin-top: 1px;
		font-size: 0.82rem;
		color: var(--dim);
		line-height: 1.4;
	}
	.panel-list a[aria-current="page"] {
		background: var(--panel-strong);
	}
	.all {
		margin-top: 4px;
		border-top: 1px solid var(--border);
		padding-top: 4px;
	}
	.all a {
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--violet);
	}

	/* Open on hover only where hovering exists. On a touchscreen `:hover` sticks
	   after a tap, which leaves a panel open over the page with no way to shut
	   it — there the caret button does the work instead. */
	@media (hover: hover) and (pointer: fine) {
		.grp:hover > .panel {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
		.grp:hover .caret svg {
			transform: rotate(180deg);
		}
	}

	/* Keyboard and script get the same result by a different route. */
	.grp:focus-within > .panel,
	.grp.open > .panel {
		opacity: 1;
		visibility: visible;
		transform: none;
	}
	.grp:focus-within .caret svg,
	.grp.open .caret svg {
		transform: rotate(180deg);
	}

	/* Somebody who has asked for less movement gets the panel, not the slide. */
	@media (prefers-reduced-motion: reduce) {
		.panel,
		.caret svg {
			transition: none;
		}
	}

	.buy {
		padding: 10px 18px;
		font-size: 0.92rem;
		flex: none;
	}

	/* Below 1120px the links drop onto their own row under the bar rather than
	   hiding behind a hamburger — one less thing to get wrong, and crawlers see
	   the same links either way. The breakpoint moved up from 980 when the bar
	   gained a seventh entry.

	   The row **wraps**; it used to scroll sideways. A scrolling strip is an
	   overflow container, and an absolutely positioned panel inside one is
	   clipped at its edge — the menus would have opened and been invisible. */
	@media (max-width: 1120px) {
		.bar {
			height: auto;
			flex-wrap: wrap;
			padding-block: 12px;
			gap: 12px;
		}
		nav {
			order: 3;
			width: 100%;
			margin-left: 0;
		}
		/* With the links on their own row, the brand keeps the left and the two
		   controls take the right. */
		.theme {
			margin-left: auto;
		}
		nav > ul {
			flex-wrap: wrap;
			gap: 2px 0;
		}
		.buy {
			margin-left: auto;
		}

		/* Panels stop floating and become part of the page, opening a full-width
		   block under the row. Floating them here would put a card over the top
		   of the article somebody is reading, on the screens with least room for
		   it. Hover is not involved — only the caret opens these, which is the
		   only thing that works on a touchscreen anyway. */
		nav > ul > li {
			position: static;
		}
		.panel {
			position: absolute;
			left: 0;
			right: 0;
			padding-top: 6px;
		}
		.panel-list {
			width: auto;
			max-width: none;
		}
		.grp:hover > .panel {
			opacity: 0;
			visibility: hidden;
			transform: translateY(-6px);
		}
		.grp.open > .panel,
		.grp:focus-within > .panel {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
	}
</style>
