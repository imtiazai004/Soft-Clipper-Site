---
import { NAV, SITE } from "../consts";

const { pathname } = Astro.url;
// A link is "current" when the page sits under it, so /features/captions/ still
// highlights Features. Screen readers get aria-current, not just a colour.
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header>
	<a class="skip" href="#main">Skip to content</a>
	<div class="wrap bar">
		<a class="brand" href="/">
			<span class="mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="11" height="16" rx="2"></rect>
					<path d="M17 8v8"></path>
					<path d="M21 6v12"></path>
				</svg>
			</span>
			<span class="name">{SITE.name}</span>
		</a>

		<nav aria-label="Main">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button class="theme" type="button" id="theme-toggle" aria-label="Switch theme">
			<svg class="ic sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
			</svg>
			<svg class="ic moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			</svg>
		</button>

		<a class="btn btn-primary buy" href="/pricing/">Get Soft Clipper</a>
	</div>
</header>

{/*
  is:inline for the same reason as the head script: this is the only other
  script on the site and bundling it would start shipping a JavaScript file to
  every page for one button.
*/}
<script is:inline>
	(function () {
		var root = document.documentElement;
		var button = document.getElementById("theme-toggle");
		var meta = document.getElementById("theme-color");
		if (!button) return;

		var PAGE = { light: "#ffffff", dark: "#0f0e1e" };

		function paint() {
			var dark = root.dataset.theme === "dark";
			// The label says what pressing it will do, not what is on screen.
			button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
			if (meta) meta.setAttribute("content", dark ? PAGE.dark : PAGE.light);
		}

		button.addEventListener("click", function () {
			var next = root.dataset.theme === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch (e) {
				/* No storage: the choice holds for this page only. */
			}
			paint();
		});

		paint();
	})();
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--nav-bg);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.skip {
		position: absolute;
		left: -9999px;
		top: 8px;
		background: var(--bg-soft);
		border: 1px solid var(--border-strong);
		padding: 8px 14px;
		border-radius: 8px;
	}
	.skip:focus {
		left: 16px;
		z-index: 60;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 68px;
	}

	/* ── theme toggle ────────────────────────────────────────────────────── */

	.theme {
		flex: none;
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}
	.theme:hover {
		color: var(--text);
		border-color: var(--border-strong);
		background: var(--panel-strong);
	}
	.theme:focus-visible {
		outline: 2px solid var(--violet);
		outline-offset: 2px;
	}
	.theme .ic {
		grid-area: 1 / 1;
	}

	/* The icon shown is the one you are about to get, not the one you are in —
	   a moon on a light page, a sun on a dark one. :global() because the theme
	   attribute lives on <html>, which is outside this component and so must not
	   be given a scoping attribute. */
	.theme .sun {
		display: none;
	}
	.theme .moon {
		display: block;
	}
	:global(:root[data-theme="dark"]) .theme .sun {
		display: block;
	}
	:global(:root[data-theme="dark"]) .theme .moon {
		display: none;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 800;
		letter-spacing: -0.02em;
		flex: none;
	}
	.mark {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--grad);
		color: #fff;
		display: grid;
		place-items: center;
		box-shadow: 0 4px 14px rgba(91, 45, 214, 0.28);
	}

	nav {
		margin-left: auto;
	}
	nav ul {
		display: flex;
		gap: 4px;
		list-style: none;
	}
	nav a {
		display: block;
		padding: 8px 12px;
		border-radius: 9px;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.94rem;
		font-weight: 550;
		transition: color 0.15s ease, background 0.15s ease;
	}
	nav a:hover {
		color: var(--text);
		background: var(--panel);
	}
	nav a[aria-current="page"] {
		color: var(--text);
		background: var(--panel-strong);
	}

	.buy {
		padding: 10px 18px;
		font-size: 0.92rem;
		flex: none;
	}

	/* Below 980px the links wrap into a scrollable strip under the bar rather
	   than hiding behind a hamburger — one less thing to get wrong, and crawlers
	   see the same links either way. */
	@media (max-width: 980px) {
		.bar {
			height: auto;
			flex-wrap: wrap;
			padding-block: 12px;
			gap: 12px;
		}
		nav {
			order: 3;
			width: 100%;
			margin-left: 0;
			overflow-x: auto;
			scrollbar-width: none;
		}
		/* With the links on their own row, the brand keeps the left and the two
		   controls take the right. */
		.theme {
			margin-left: auto;
		}
		nav::-webkit-scrollbar {
			display: none;
		}
		nav ul {
			gap: 2px;
		}
		nav a {
			white-space: nowrap;
			padding-inline: 10px;
		}
		.buy {
			margin-left: auto;
		}
	}
</style>
