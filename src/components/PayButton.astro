---
/**
 * The buy button, in one place so every page that sells says the same thing.
 *
 * When the Stripe Payment Link is configured it goes straight there. When it is
 * not, it does not quietly fall back to a page that cannot take money — that is
 * how a site ends up with a button that looks like it works, sends nobody
 * anywhere useful, and loses the sale silently. It says what is true and gives
 * the buyer a person to talk to instead, and the build prints a warning so this
 * state cannot be forgotten.
 */
import { PRICE, SITE } from "../consts";

interface Props {
	/** Button text. `$49` is appended by the caller if they want it. */
	label?: string;
	/** `ghost` for secondary placements. */
	variant?: "primary" | "ghost";
	class?: string;
}

const { label = `Buy ${SITE.name} — ${PRICE.display}`, variant = "primary", class: extra = "" } = Astro.props;

const ready = PRICE.checkoutUrl.length > 0;

/**
 * A Stripe test link takes no money. Shipping one to a live site is a silent
 * failure: the button works, the checkout looks real, the customer believes
 * they have bought something, and nothing was ever charged. So it is called out
 * on the page as well as in the build — a warning only the developer sees would
 * not protect the person clicking the button.
 */
const isTestLink = PRICE.checkoutUrl.includes("/test_");

if (!globalThis.__softClipperCheckoutWarned) {
	globalThis.__softClipperCheckoutWarned = true;
	if (!ready) {
		console.warn(
			"\n  ⚠  PRICE.checkoutUrl is empty — the site cannot take payments.\n" +
				"     Create a Stripe Payment Link and put it in src/consts.ts.\n",
		);
	} else if (isTestLink) {
		console.warn(
			"\n  ⚠  PRICE.checkoutUrl is a Stripe TEST link — this build takes no money.\n" +
				"     Replace it with the live link before announcing the product.\n",
		);
	}
}

const href = ready
	? PRICE.checkoutUrl
	: `${SITE.waLink}?text=${encodeURIComponent(`Hi, I would like to buy ${SITE.name}.`)}`;
---

<a
	class={`btn btn-${variant} ${extra}`}
	href={href}
	rel={ready ? "nofollow" : "nofollow noopener"}
	target={ready ? undefined : "_blank"}
>
	{ready ? label : "Message us to buy"}
</a>

{
	!ready && (
		<p class="small muted pending">
			Card checkout is being switched on. Until it is, message us and we will send
			your licence key the same day.
		</p>
	)
}

{
	ready && isTestLink && (
		<p class="testmode">
			<strong>Test mode.</strong> This checkout takes no money — we are still setting
			payments up. Nothing you enter here will be charged.
		</p>
	)
}

<style>
	.pending {
		margin-top: 8px;
		max-width: 42ch;
	}

	/* Deliberately loud. Its whole job is to stop someone believing they have
	   bought something they have not. */
	.testmode {
		margin-top: 10px;
		padding: 9px 13px;
		border-radius: 10px;
		border: 1px solid var(--warn);
		background: color-mix(in srgb, var(--warn) 12%, transparent);
		color: var(--text);
		font-size: 0.85rem;
		line-height: 1.5;
		max-width: 46ch;
	}
</style>
