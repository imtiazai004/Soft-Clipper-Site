---
/**
 * The price, with the one it replaced struck through beside it.
 *
 * One component rather than three hand-written versions, because the old price
 * and the new one have to move together. The failure mode of writing "$49" as
 * literal text somewhere is not a broken build — it is a page that quietly
 * advertises a price the checkout will not honour, and the customer finds it
 * before we do.
 *
 * Everything is read from PRICE, so when the discount ends, deleting
 * `listAmount` and this component's usages is the whole job.
 *
 * The old price is marked up with `<s>` — "no longer accurate" — rather than
 * styled with `text-decoration` on a plain span, so it is still a former price
 * when the stylesheet does not load and when it is read aloud. A screen reader
 * announces the struck text without saying why it is struck, hence the hidden
 * "Was".
 */
import { PRICE } from "../consts";

interface Props {
	/** `block` is the big number on the pricing card; `inline` fits in a sentence. */
	size?: "block" | "inline";
	/** The green "Save $10" chip. Off by default — it is loud, and most places only need the two numbers. */
	saving?: boolean;
	/**
	 * `was` renders only the struck-through old price, for the places where the
	 * new one is already in the button right next to it. Printing $39 twice in
	 * one block reads as a mistake; "was $49" underneath it reads as the offer.
	 */
	show?: "both" | "was";
	class?: string;
}

const { size = "inline", saving = false, show = "both", class: extra = "" } = Astro.props;

// Nothing to compare against means no comparison: the component degrades to
// just the price rather than rendering an empty strikethrough.
const discounted = PRICE.listAmount > PRICE.amount;
---

<span class:list={["tag", size, extra]}>
	{
		discounted && (
			<span class="wasgroup">
				{/*
				 * The word carries the meaning for a screen reader, which cannot see a
				 * line through anything. Beside the new price the strikethrough says it
				 * well enough on its own, so the word is hidden; alone it is not, so it
				 * is shown. Either way it stays outside the <s> — striking through the
				 * word "was" as well as the number is how that trick looks cheap.
				 */}
				<span class:list={["waslabel", show === "both" && "visually-hidden"]}>was </span>
				<s class="was">{PRICE.listDisplay}</s>
			</span>
		)
	}
	{show === "both" && <span class="now">{PRICE.display}</span>}
	{discounted && saving && <span class="off">Save {PRICE.savingDisplay}</span>}
</span>

<style>
	.tag {
		display: inline-flex;
		align-items: baseline;
		gap: 10px;
		white-space: nowrap;
	}

	/*
	 * `color: inherit` with opacity, not a fixed grey. This sits on the white
	 * pricing card, inside a violet pill, and on the near-black CTA band, and a
	 * grey that reads as "secondary" on one of those is invisible on another.
	 * Dimming whatever colour it inherits works on all three.
	 */
	.wasgroup {
		display: inline-flex;
		align-items: baseline;
		gap: 0.28em;
		color: inherit;
		opacity: 0.55;
	}
	.waslabel {
		font-weight: 500;
		font-size: 0.85em;
	}
	.was {
		font-weight: 600;
		/* The default line through the middle cuts the digits; this sits lower
		   and leaves them legible, which matters — an unreadable old price reads
		   as a trick rather than a discount. */
		text-decoration-thickness: 0.09em;
	}

	.now {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.off {
		font-size: 0.72em;
		font-weight: 700;
		padding: 3px 9px;
		border-radius: 999px;
		/* Same inherit-and-tint trick as .was, for the same reason. */
		background: color-mix(in srgb, currentColor 13%, transparent);
		border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	/* ── block: the pricing card ─────────────────────────────────────────────── */

	.block .now {
		font-size: clamp(2.8rem, 7vw, 4rem);
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.block .wasgroup {
		font-size: clamp(1.3rem, 3vw, 1.75rem);
		line-height: 1;
	}
	.block .off {
		font-size: 0.8rem;
		/* The chip is the only part that should not scale with a 4rem number. */
		align-self: center;
		color: var(--ok);
		background: color-mix(in srgb, var(--ok) 10%, transparent);
		border-color: color-mix(in srgb, var(--ok) 26%, transparent);
	}

	/* ── inline: pills, bands, sentences ─────────────────────────────────────── */

	.inline {
		gap: 7px;
	}
	.inline .wasgroup {
		font-size: 0.92em;
	}
</style>
