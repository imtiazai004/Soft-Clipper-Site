---
/**
 * The five framing modes, switchable, shown on a real frame.
 *
 * The question a buyer has is "what does it do to my shot", and a diagram made
 * of coloured rectangles cannot answer it. So this is a still from an actual
 * two-person podcast: the left panel is the 16:9 source with the crop drawn on
 * it, and the right panel is the 9:16 result, made by showing exactly the region
 * inside that crop. Change mode and both panels change together.
 *
 * The crop windows below are fractions of the source frame, and the percentages
 * the CSS needs are worked out from them here rather than typed in twice. A
 * 9:16 window out of a 16:9 frame is 31.64% of its width, which is where that
 * number keeps coming from.
 *
 * Hidden radios and :has(). No JavaScript.
 */
import { imageSize } from "../lib/imageSize";
import fs from "node:fs";

const SRC = "/shots/wide.jpg";
const size = fs.existsSync("public/shots/wide.jpg") ? imageSize(SRC) : null;

/** A 9:16 window out of a 16:9 frame, as a fraction of the frame's width. */
const W916 = (9 / 16) / (16 / 9); // 0.3164

/**
 * Where the faces are in this particular frame, measured off it: she is left of
 * centre, he is at the right edge with his back to camera.
 */
const HER = 0.22;
const HIM = 0.86;

const clamp = (c: number, w: number) => Math.min(Math.max(c - w / 2, 0), 1 - w);
const pc = (n: number) => `${(n * 100).toFixed(2)}%`;

/**
 * A window centred on `c` and `w` wide, expressed twice: where to draw the crop
 * box on the source, and how to size and offset the image so that same window
 * fills the output pane.
 */
const win = (c: number, w: number) => {
	const x = clamp(c, w);
	return {
		cropLeft: pc(x),
		cropWidth: pc(w),
		imgWidth: pc(1 / w),
		imgLeft: pc(-x / w),
	};
};

// Smart tracking drifts the crop with the speaker; these are the two ends of it.
const smartA = win(HER - 0.05, W916);
const smartB = win(HER + 0.05, W916);
const centre = win(0.5, W916);

// Split stacks two 9:8 panels, each holding its own person.
const W98 = (9 / 8) / (16 / 9); // 0.6328
const splitTop = win(HER, W98);
const splitBottom = win(HIM, W98);

/**
 * Game + cam, matching _gamecam_filter_complex in core/video.py: the camera
 * panel is 600 of the output's 1920 rows, and the camera itself is a fixed box
 * a quarter of the frame wide and a third of it tall, sitting in a corner —
 * bottom-left by default. Nothing is detected, because a facecam does not move.
 */
const CAM_SHARE = 600 / 1920;
const CAM_W = 0.25;
const CAM_H = 0.3;
const CAM_CX = 0.135;
const CAM_CY = 0.79;

const camX = clamp(CAM_CX, CAM_W);
const camY = clamp(CAM_CY, CAM_H);

// The top pane in units where its own width is 1: tall enough to hold the
// camera box once the image is blown up to put that box across the pane.
const camPaneH = (16 / 9) * CAM_SHARE;
const camImgH = (1 / CAM_W) * (9 / 16);
const cam = {
	cropLeft: pc(camX),
	cropTop: pc(camY),
	cropWidth: pc(CAM_W),
	cropHeight: pc(CAM_H),
	imgWidth: pc(1 / CAM_W),
	imgLeft: pc(-camX / CAM_W),
	imgTop: `${(((camPaneH / 2 - (camY + CAM_H / 2) * camImgH) / camPaneH) * 100).toFixed(2)}%`,
};

const modes = [
	{
		id: "smart",
		label: "Smart",
		note: "Tracks the speaker and drifts the crop with them, then re-picks the subject when the scene cuts. The default, and right for most talking footage.",
	},
	{
		id: "fit",
		label: "Fit + blur",
		note: "Keeps the entire frame and fills the space above and below with a blurred copy. The only honest answer for screen shares and slides, where cropping deletes the content.",
	},
	{
		id: "split",
		label: "Split",
		note: "Two speakers stacked, each cropped to their own face. What most interview clips use, and for good reason — look at what the centre crop does to this same shot.",
	},
	{
		id: "centre",
		label: "Centre",
		note: "A fixed centre crop with no tracking. Predictable and fastest to render — and on a two-shot like this one, it keeps the gap between the speakers and loses both of them.",
	},
	{
		id: "game",
		label: "Game + cam",
		note: "Your camera on top, gameplay below — fitted, never cropped, because a game cut to 9:16 loses the half of the screen where things happen.",
	},
];
---

<div
	class="framing-demo stage"
	style={[
		`--w916:${pc(W916)}`,
		`--smart-cx1:${smartA.cropLeft}; --smart-cx2:${smartB.cropLeft}`,
		`--smart-iw:${smartA.imgWidth}; --smart-ix1:${smartA.imgLeft}; --smart-ix2:${smartB.imgLeft}`,
		`--centre-cx:${centre.cropLeft}; --centre-ix:${centre.imgLeft}`,
		`--split-cw:${splitTop.cropWidth}; --split-cx1:${splitTop.cropLeft}; --split-cx2:${splitBottom.cropLeft}`,
		`--split-iw:${splitTop.imgWidth}; --split-ix1:${splitTop.imgLeft}; --split-ix2:${splitBottom.imgLeft}`,
		`--cam-cw:${cam.cropWidth}; --cam-cx:${cam.cropLeft}`,
		`--cam-ch:${cam.cropHeight}; --cam-cy:${cam.cropTop}`,
		`--cam-iw:${cam.imgWidth}; --cam-ix:${cam.imgLeft}; --cam-iy:${cam.imgTop}`,
		`--cam-share:${(CAM_SHARE * 100).toFixed(2)}%`,
	].join("; ")}
>
	{modes.map((m, i) => <input type="radio" name="framing" id={`fr-${m.id}`} checked={i === 0} hidden />)}

	<div class="tabs" role="tablist" aria-label="Framing modes">
		{modes.map((m) => <label class={`tab tab-${m.id}`} for={`fr-${m.id}`} tabindex="0">{m.label}</label>)}
	</div>

	<div class="stagebox">
		<div class="demo">
			<figure class="panel source">
				<div class="box">
					{
						size ? (
							<img src={SRC} alt="A wide shot of two people in a podcast studio" width={size.width} height={size.height} loading="lazy" decoding="async" />
						) : (
							<div class="stand-in" />
						)
					}
					<div class="crop" aria-hidden="true"></div>
					<div class="crop crop-2" aria-hidden="true"></div>
				</div>
				<figcaption class="mono">Source · 16:9</figcaption>
			</figure>

			<span class="arrow" aria-hidden="true"></span>

			<figure class="panel result">
				<div class="box">
					<div class="pane pane-a">
						{size && <img class="haze" src={SRC} alt="" aria-hidden="true" width={size.width} height={size.height} loading="lazy" decoding="async" />}
						{size && <img class="cut" src={SRC} alt="" aria-hidden="true" width={size.width} height={size.height} loading="lazy" decoding="async" />}
					</div>
					<div class="pane pane-b">
						{size && <img class="cut" src={SRC} alt="" aria-hidden="true" width={size.width} height={size.height} loading="lazy" decoding="async" />}
						<span class="tag mono">your gameplay · fitted</span>
					</div>
				</div>
				<figcaption class="mono">Output · 9:16</figcaption>
			</figure>
		</div>

		<div class="notes">
			{modes.map((m) => <p class={`note note-${m.id}`}>{m.note}</p>)}
			<p class="small muted foot">
				Any mode can be overridden per clip in the frame editor — drag the crop
				where you want it and the preview shows the real result.
			</p>
		</div>
	</div>
</div>

<style>
	.framing-demo {
		padding: clamp(20px, 3vw, 30px);
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 22px;
	}
	.tab {
		padding: 8px 15px;
		border-radius: 999px;
		border: 1px solid var(--stage-border);
		color: var(--stage-muted);
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		user-select: none;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}
	.tab:hover {
		color: var(--stage-text);
		border-color: rgba(255, 255, 255, 0.3);
	}
	.tab:focus-visible {
		outline: 2px solid var(--cyan-bright);
		outline-offset: 2px;
	}

	.stagebox {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(20px, 4vw, 40px);
		align-items: center;
	}

	.demo {
		display: flex;
		align-items: center;
		gap: clamp(10px, 2vw, 18px);
	}

	.panel {
		margin: 0;
		display: grid;
		gap: 7px;
		justify-items: center;
	}
	.panel figcaption {
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		color: var(--stage-muted);
	}
	.box {
		position: relative;
		overflow: hidden;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: #0a0918;
	}

	.source .box {
		width: min(360px, 46vw);
		aspect-ratio: 16 / 9;
	}
	.source img,
	.stand-in {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.stand-in {
		background: linear-gradient(160deg, #241d4d, #0e0c22);
	}

	/* The crop drawn on the source. Everything outside it is dimmed by a very
	   large spread shadow, which is what makes the kept region read as kept. */
	.crop {
		position: absolute;
		box-sizing: border-box;
		top: 0;
		height: 100%;
		left: calc(50% - var(--w916) / 2);
		width: var(--w916);
		border: 2px solid var(--cyan-bright);
		border-radius: 5px;
		box-shadow: 0 0 0 100vmax rgba(6, 5, 16, 0.6);
		transition:
			left 0.45s cubic-bezier(0.4, 0, 0.2, 1),
			top 0.45s cubic-bezier(0.4, 0, 0.2, 1),
			width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
			height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
			opacity 0.25s ease;
	}
	.crop-2 {
		opacity: 0;
		box-shadow: none;
	}

	.result .box {
		width: min(158px, 22vw);
		aspect-ratio: 9 / 16;
		display: grid;
		grid-template-rows: 1fr;
	}
	.pane {
		position: relative;
		overflow: hidden;
	}
	.pane-b {
		display: none;
	}
	/* The image is blown up until the chosen window is exactly as wide as the
	   pane, then slid so that window is the part you can see. */
	.pane img {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		height: auto;
		max-width: none;
		width: var(--smart-iw);
		left: var(--smart-ix1);
		transition: left 0.45s cubic-bezier(0.4, 0, 0.2, 1), width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.haze {
		display: none;
	}
	.tag {
		position: absolute;
		left: 6px;
		right: 6px;
		bottom: 6px;
		display: none;
		padding: 3px 0;
		text-align: center;
		border-radius: 5px;
		font-size: 0.52rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--stage-text);
		background: rgba(10, 8, 26, 0.72);
	}

	.arrow {
		width: 22px;
		height: 1px;
		flex: none;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
		position: relative;
	}
	.arrow::after {
		content: "";
		position: absolute;
		right: 0;
		top: -3px;
		border: 3.5px solid transparent;
		border-left-color: rgba(255, 255, 255, 0.45);
	}

	.notes {
		display: grid;
		gap: 10px;
	}
	.note {
		display: none;
		color: var(--stage-text);
		font-size: 1.02rem;
		max-width: 44ch;
	}
	.foot {
		max-width: 46ch;
	}

	@media (max-width: 760px) {
		.stagebox {
			grid-template-columns: 1fr;
		}
		.demo {
			justify-content: center;
		}
	}

	/* ── switching ───────────────────────────────────────────────────────── */

	.framing-demo:has(#fr-smart:checked) .tab-smart,
	.framing-demo:has(#fr-fit:checked) .tab-fit,
	.framing-demo:has(#fr-split:checked) .tab-split,
	.framing-demo:has(#fr-centre:checked) .tab-centre,
	.framing-demo:has(#fr-game:checked) .tab-game {
		color: #0b0a18;
		background: var(--cyan-bright);
		border-color: var(--cyan-bright);
	}

	.framing-demo:has(#fr-smart:checked) .note-smart,
	.framing-demo:has(#fr-fit:checked) .note-fit,
	.framing-demo:has(#fr-split:checked) .note-split,
	.framing-demo:has(#fr-centre:checked) .note-centre,
	.framing-demo:has(#fr-game:checked) .note-game {
		display: block;
	}

	/* Smart: the crop sits on her and drifts, and the output drifts with it. */
	.framing-demo:has(#fr-smart:checked) .crop {
		left: var(--smart-cx1);
		animation: cropDrift 6s ease-in-out infinite;
	}
	.framing-demo:has(#fr-smart:checked) .pane-a .cut {
		animation: cutDrift 6s ease-in-out infinite;
	}

	/* Fit + blur: nothing is cropped, so the source keeps no highlight and the
	   output shows the whole frame over a blurred copy of itself. */
	.framing-demo:has(#fr-fit:checked) .crop {
		opacity: 0;
	}
	.framing-demo:has(#fr-fit:checked) .pane-a .cut {
		width: 100%;
		left: 0;
	}
	.framing-demo:has(#fr-fit:checked) .haze {
		display: block;
		width: 200%;
		left: -50%;
		height: 100%;
		object-fit: cover;
		filter: blur(18px) saturate(1.3);
		opacity: 0.6;
		translate: 0 -50%;
	}

	/* Split: two windows on the source, two panes in the output. */
	.framing-demo:has(#fr-split:checked) .crop {
		left: var(--split-cx1);
		width: var(--split-cw);
		box-shadow: none;
		border-color: var(--violet);
	}
	.framing-demo:has(#fr-split:checked) .crop-2 {
		opacity: 1;
		left: var(--split-cx2);
		width: var(--split-cw);
	}
	.framing-demo:has(#fr-split:checked) .result .box {
		grid-template-rows: 1fr 1fr;
	}
	.framing-demo:has(#fr-split:checked) .pane-b {
		display: block;
	}
	.framing-demo:has(#fr-split:checked) .pane-a .cut {
		width: var(--split-iw);
		left: var(--split-ix1);
	}
	.framing-demo:has(#fr-split:checked) .pane-b .cut {
		width: var(--split-iw);
		left: var(--split-ix2);
	}

	/* Centre: fixed, no tracking — and on this frame that is the point. */
	.framing-demo:has(#fr-centre:checked) .crop {
		left: var(--centre-cx);
		animation: none;
	}
	.framing-demo:has(#fr-centre:checked) .pane-a .cut {
		left: var(--centre-ix);
	}

	/* Game + cam: the camera box in the corner is promoted to the top strip, and
	   whatever is below it is fitted whole rather than cropped. The proportions
	   are the ones in core/video.py — a quarter of the frame wide, a third of it
	   tall, taking 600 of the output's 1920 rows. */
	.framing-demo:has(#fr-game:checked) .crop {
		left: var(--cam-cx);
		top: var(--cam-cy);
		width: var(--cam-cw);
		height: var(--cam-ch);
		border-color: var(--violet);
	}
	.framing-demo:has(#fr-game:checked) .result .box {
		grid-template-rows: var(--cam-share) 1fr;
	}
	.framing-demo:has(#fr-game:checked) .pane-b {
		display: block;
	}
	.framing-demo:has(#fr-game:checked) .pane-b .tag {
		display: block;
	}
	.framing-demo:has(#fr-game:checked) .pane-a .cut {
		width: var(--cam-iw);
		left: var(--cam-ix);
		top: var(--cam-iy);
		translate: 0;
	}
	/* The gameplay half is fitted, never cropped. */
	.framing-demo:has(#fr-game:checked) .pane-b .cut {
		width: 100%;
		left: 0;
	}

	@keyframes cropDrift {
		0%, 100% { left: var(--smart-cx1); }
		50% { left: var(--smart-cx2); }
	}
	@keyframes cutDrift {
		0%, 100% { left: var(--smart-ix1); }
		50% { left: var(--smart-ix2); }
	}

	@media (prefers-reduced-motion: reduce) {
		.crop,
		.cut {
			animation: none !important;
		}
	}
</style>
