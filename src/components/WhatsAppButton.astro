---
import { SITE } from "../consts";

// Sits in Base.astro so it appears on every page. Deliberately a plain link,
// not a widget: no third-party script, nothing to slow the page down, and it
// still works with JavaScript disabled.
const prefill = encodeURIComponent(`Hi, I have a question about ${SITE.name}.`);
---

<a
	class="wa"
	href={`${SITE.waLink}?text=${prefill}`}
	target="_blank"
	rel="noopener"
	aria-label={`Chat with us on WhatsApp — ${SITE.phone}`}
>
	<svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
		<path
			d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"
		></path>
		<path
			d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.87 9.87 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.13.82.84-3.05-.2-.31a8.19 8.19 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.25 8.22z"
		></path>
	</svg>
	<span>WhatsApp</span>
</a>

<style>
	.wa {
		position: fixed;
		right: 18px;
		bottom: 18px;
		z-index: 60;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 12px 18px 12px 14px;
		border-radius: 999px;
		background: #25d366;
		color: #05261a;
		font-weight: 700;
		font-size: 0.92rem;
		text-decoration: none;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
		transition:
			transform 0.15s ease,
			filter 0.15s ease;
	}
	.wa:hover {
		filter: brightness(1.06);
		transform: translateY(-2px);
	}
	.wa:active {
		transform: translateY(0);
	}

	/* On phones the label costs more than it gives — a circle keeps the thumb
	   zone clear of the page content. */
	@media (max-width: 640px) {
		.wa {
			right: 14px;
			bottom: 14px;
			padding: 14px;
			gap: 0;
		}
		.wa span {
			display: none;
		}
	}

	@media print {
		.wa {
			display: none;
		}
	}
</style>
